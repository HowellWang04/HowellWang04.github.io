---
// A small extra page, linked only from the footer: where the site's visitors come from, on a globe that can be
// dragged around and zoomed. The counts come from src/data/visitors.json, which scripts/fetch-visitors.mjs
// refreshes before each build.
import BaseLayout from "../layouts/BaseLayout.astro";
import LocalizedText from "../components/LocalizedText.astro";
import visitors from "../data/visitors.json";
import { geoArea, geoCentroid, geoGraticule10, geoOrthographic, geoPath } from "d3-geo";
import { feature } from "topojson-client";
import polygonClipping from "polygon-clipping";
import countries from "i18n-iso-countries";
import en from "i18n-iso-countries/langs/en.json";
import zh from "i18n-iso-countries/langs/zh.json";
import world110 from "world-atlas/countries-110m.json";
import world50 from "world-atlas/countries-50m.json";
import ct from "countries-and-timezones";

countries.registerLocale(en);
countries.registerLocale(zh);
// Taiwan is named as a province of China, Hong Kong and Macao as China's special administrative regions.
const names: Record<string, { en: string; zh: string }> = {
  TW: { en: "Taiwan Province, China", zh: "中国台湾省" },
  HK: { en: "Hong Kong SAR, China", zh: "中国香港特别行政区" },
  MO: { en: "Macao SAR, China", zh: "中国澳门特别行政区" },
};
const nameOf = (code: string) => names[code] ?? {
  en: countries.getName(code, "en", { select: "alias" }) ?? code,
  zh: countries.getName(code, "zh") ?? code,
};

// Taiwan, Hong Kong and Macao are part of China on the globe: they add to its shade, and hovering any of them
// lights up all of China.
const partOf: Record<string, string> = { TW: "CN", HK: "CN", MO: "CN" };
const groupOf = (code: string) => partOf[code] ?? code;

const counts = new Map(visitors.countries.map(({ code, count }) => [code, count]));
const groupTotals = new Map<string, number>();
counts.forEach((count, code) => groupTotals.set(groupOf(code), (groupTotals.get(groupOf(code)) ?? 0) + count));
const max = Math.max(1, ...counts.values());
// More visitors, bigger pin and deeper shade. Log scale, so one country with most of the visitors doesn't dwarf
// or wash out every other one.
const pinSize = (count: number) => (0.8 + 0.6 * Math.log(1 + count) / Math.log(1 + max)).toFixed(2);
const maxGroup = Math.max(1, ...groupTotals.values());
const shade = (count: number) => (0.2 + 0.5 * Math.log(1 + count) / Math.log(1 + maxGroup)).toFixed(2);

// Antarctica only takes up room.
const toShapes = (world: any) =>
  (feature(world, world.objects.countries) as any).features.filter((shape: any) => shape.id !== "010");
const codeOf = (shape: any) => (shape.id ? countries.numericToAlpha2(shape.id) : undefined);
const shapes = toShapes(world110);

// The map data puts South Tibet (Zangnan), south of the McMahon Line, in India; here it is part of China. This
// outline's southern edge follows the foothills along the Assam plain. The rest of it reaches well past India's
// borders, and clipping it to India's shape supplies the true outline there.
const zangnanOutline = [[
  [92.05, 26.9], [92.55, 26.95], [93.0, 26.95], [93.45, 26.95], [93.85, 27.0], [94.1, 27.35], [94.4, 27.55],
  [94.7, 27.75], [95.05, 27.85], [95.35, 27.9], [95.6, 27.6], [96.05, 27.55], [96.05, 27.3], [95.8, 27.22],
  [95.45, 27.22], [95.25, 27.1], [95.2, 26.9], [95.2, 26.6], [96.5, 26.0], [98.5, 26.0], [98.5, 30.5],
  [91.0, 30.5], [91.0, 27.3], [91.9, 26.95], [92.05, 26.9],
]];
const polygonsOf = (geometry: any) => (geometry.type === "Polygon" ? [geometry.coordinates] : geometry.coordinates);
// d3 wants outer rings clockwise and holes anticlockwise; polygon-clipping returns the opposite.
const ringArea = (ring: number[][]) =>
  ring.slice(1).reduce((sum, [x, y], i) => sum + ring[i][0] * y - x * ring[i][1], 0);
const toD3 = (multi: any) => ({
  type: "MultiPolygon",
  coordinates: multi.map((polygon: any) =>
    polygon.map((ring: any, i: number) => ((ringArea(ring) > 0) === (i === 0) ? [...ring].reverse() : ring))),
});
const china = shapes.find((shape: any) => shape.id === "156");
const india = shapes.find((shape: any) => shape.id === "356");
const zangnan = polygonClipping.intersection(polygonsOf(india.geometry), zangnanOutline as any);
china.geometry = toD3(polygonClipping.union(polygonsOf(china.geometry), zangnan));
india.geometry = toD3(polygonClipping.difference(polygonsOf(india.geometry), zangnan));

// Where a place's pin goes, found with the detailed map so small places (Singapore, Hong Kong...) get one too.
// It stands on the largest piece of land, so France's lands in France, not the Atlantic. Some places come in
// more than one shape (Australia and its outlying islands), so the pieces are pooled first.
const lands = new Map<string, any[]>();
toShapes(world50).forEach((shape: any) => {
  const code = codeOf(shape);
  if (!code) return;
  const pieces = polygonsOf(shape.geometry).map((coordinates: any) => ({ type: "Polygon", coordinates }));
  lands.set(code, [...(lands.get(code) ?? []), ...pieces]);
});
const anchors = new Map([...lands].map(([code, pieces]) => {
  const land = pieces.reduce((a, b) => (geoArea(a) >= geoArea(b) ? a : b));
  return [code, geoCentroid(land).map((n) => +n.toFixed(2))];
}));

// Every visited country or region gets one pin.
const visits = visitors.countries
  .filter(({ code }) => anchors.has(code))
  .map(({ code, count }) => ({ code, count, at: anchors.get(code)! }));

// The browser can tell a newcomer's country from their clock's time zone, without asking anyone, so the page
// can greet them and turn the globe to them the moment it opens. It gets each zone's country, and each
// country's spot, name and the group it lights up with.
const zones: Record<string, string> = {};
const youPlaces: Record<string, { at: number[]; en: string; zh: string; group: string }> = {};
Object.values(ct.getAllTimezones({ deprecated: true })).forEach(({ name, countries: [code] }) => {
  if (!code || !anchors.has(code)) return;
  zones[name] = code;
  youPlaces[code] = { at: anchors.get(code)!, ...nameOf(code), group: groupOf(code) };
});

// The browser redraws the globe as it turns, so it gets the shapes too, rounded to keep the page small.
const round = (value: any): any => (typeof value === "number" ? Math.round(value * 10) / 10 : value.map(round));
const geometries = shapes.map((shape: any) => ({ type: shape.geometry.type, coordinates: round(shape.geometry.coordinates) }));

// Countries are drawn in groups, so China lights up as a whole.
type Part = { index: number; code?: string };
const groups = new Map<string, Part[]>();
shapes.forEach((shape: any, index: number) => {
  const code = codeOf(shape);
  const key = code ? groupOf(code) : `shape-${index}`;
  groups.set(key, [...(groups.get(key) ?? []), { index, code }]);
});

// The first view faces East Asia.
// The globe fills the height; the browser widens the view to the card's shape.
const size = 600;
const wide = 900;
const rotate: [number, number] = [-105, -25];
const projection = geoOrthographic().rotate(rotate)
  .fitExtent([[(wide - size) / 2 + 16, 16], [(wide + size) / 2 - 16, size - 16]], { type: "Sphere" });
const path = geoPath(projection).digits(1);
const scale = projection.scale();
const front = (at: number[]) => {
  const point = projection(at as [number, number]);
  return path({ type: "Point", coordinates: at }) ? point : undefined;
};
// Seen from far off, a needle standing out of the globe points away from the centre, and shows the more of its
// length the nearer it stands to the edge. This is where its ball ends up, relative to its tip.
// Real pins never go in quite straight, so each leans a little its own way (mostly upward, so the ball sits
// above the tip). The lean comes from the place's code, so it stays the same from one visit to the next.
const pinHeight = 14;
const leanOf = (code: string) => {
  const hash = [...code].reduce((sum, letter) => sum * 31 + letter.charCodeAt(0), 7);
  const angle = (-90 + (hash % 100) - 50) * Math.PI / 180;
  const length = 6 + (hash % 3);
  return [+(length * Math.cos(angle)).toFixed(2), +(length * Math.sin(angle)).toFixed(2)];
};
const pinTop = ([x, y]: number[], [lx, ly]: number[]) => {
  const [cx, cy] = projection.translate();
  return [+(pinHeight * (x - cx) / scale + lx).toFixed(2), +(pinHeight * (y - cy) / scale + ly).toFixed(2)];
};
// The fun fact: places that matter to me, pinned on the globe when the button is pressed. Labels sit to the right
// of the pin unless they'd run into a neighbour.
const funPlaces = [
  { at: [121.47, 31.23], left: false, place: { en: "Shanghai", zh: "上海" }, note: { en: "Where I grew up", zh: "我长大的地方" } },
  { at: [-89.4, 43.07], left: false, place: { en: "Madison", zh: "麦迪逊" }, note: { en: "Where I am now", zh: "我现在在这里" } },
  { at: [129.77, 43.31], left: false, place: { en: "Wangqing, Jilin", zh: "吉林汪清" }, note: { en: "My father's hometown", zh: "父亲的家乡" } },
  { at: [106.35, 39.19], left: true, place: { en: "Shitanjing, Ningxia", zh: "宁夏石炭井" }, note: { en: "My mother's hometown", zh: "母亲的家乡" } },
  { at: [119.3, 26.08], left: false, place: { en: "Fuzhou", zh: "福州" }, note: { en: "Where my girlfriend lives", zh: "女朋友住的地方" } },
];
const funLabel = ({ place, note }: (typeof funPlaces)[number]) =>
  ({ en: `${note.en} · ${place.en}`, zh: `${note.zh} · ${place.zh}` });

const globeData = JSON.stringify({
  size, scale, rotate, pinHeight, zones, geometries, visits: visits.map(({ at }: any) => at), pins: funPlaces.map(({ at }) => at),
  youPlaces: Object.fromEntries(Object.entries(youPlaces).map(([code, place]) => [code, { ...place, lean: leanOf(code) }])),
  // For adding a newcomer's own visit on the spot: when these numbers were fetched, and the scales they set.
  builtAt: Date.now(), maxCount: max, maxGroup,
});

const places = visitors.countries.length;
---

<BaseLayout title="Visitors">
  <section class="visitors">
    <h1 class="text-3xl font-bold font-heading mb-8 text-center" data-reveal><LocalizedText en="Visitor Map" zh="访客地图" /></h1>
    <!-- Filled in by the script from the newcomer's time zone; hovering it says where the guess comes from. -->
    <!-- Said by me, in a speech bubble. -->
    <div class="visitor-hello" data-visitor-hello hidden>
      <p class="hello-bubble"><span data-hello-text></span><span class="hello-wave" aria-hidden="true">👋</span></p>
    </div>
    {places === 0 && (
      <p class="-mt-5 mb-8 opacity-80 text-center" data-reveal data-no-visitors>
        <LocalizedText en="No visitors counted yet. You might be the first." zh="还没有统计到访客，你也许是第一位。" />
      </p>
    )}

    <!-- data-lenis-prevent-wheel: the wheel zooms the globe here instead of scrolling the page. -->
    <figure class="map-card" data-reveal data-visitor-map data-lenis-prevent-wheel>
      <svg viewBox={`0 0 ${wide} ${size}`} class="globe" role="img" aria-label="Globe showing where visitors come from" data-globe>
        <path class="globe-sphere" d={path({ type: "Sphere" })} data-globe-sphere />
        <path class="globe-graticule" d={path(geoGraticule10())} data-globe-graticule />
        {[...groups].map(([group, parts]) => {
          const total = groupTotals.get(group) ?? 0;
          return (
            <g class:list={["country-group", { "is-visited": total > 0 }]} style={total ? `--shade: ${shade(total)}` : undefined}
              data-group-box={group} data-total={total}>
              {parts.map(({ index, code }) => {
                const label = total && code
                  ? { "data-country": code, "data-name-en": nameOf(code).en, "data-name-zh": nameOf(code).zh, "data-count": counts.get(code) ?? 0 }
                  : {};
                return <path class="country" d={path(shapes[index])} data-shape={index} data-group={group} {...label} />;
              })}
            </g>
          );
        })}
        <!-- A pin for each visited place: a glossy muted red ball on a steel needle, standing out of the globe
             with a slight lean. Toward the edge the needle shows more and more, pointing away from the centre.
             The gradient gives the ball its roundness. -->
        <defs>
          <radialGradient id="pin-ball" cx="0.35" cy="0.3" r="0.75">
            <stop offset="0" class="pin-ball-light" />
            <stop offset="0.45" class="pin-ball-mid" />
            <stop offset="1" class="pin-ball-dark" />
          </radialGradient>
        </defs>
        {visits.map(({ code, count, at }: any, index: number) => {
          const point = front(at);
          const top = point ? pinTop(point, leanOf(code)) : [0, -pinHeight];
          return (
            <g class="visit-pin" data-visit={index} data-country={code} data-name-en={nameOf(code).en}
              data-name-zh={nameOf(code).zh} data-count={count} data-lean={leanOf(code).join(" ")}
              transform={point ? `translate(${point[0].toFixed(1)} ${point[1].toFixed(1)})` : undefined}
              style={point ? undefined : "visibility: hidden"}>
              <g class="visit-pin-body" style={`--size: ${pinSize(count)}`}>
                <line class="visit-pin-hit" x2={top[0]} y2={top[1]} data-needle />
                <circle class="visit-pin-shadow" r="2.5" />
                <line class="visit-pin-needle" x2={top[0]} y2={top[1]} data-needle />
                <line class="visit-pin-glint" x2={top[0]} y2={top[1]} data-needle />
                <g transform={`translate(${top[0]} ${top[1]})`} data-ball>
                  <circle class="visit-pin-head" r="5" />
                  <ellipse class="visit-pin-shine" cx="-1.8" cy="-2" rx="1.6" ry="1.1" transform="rotate(-30 -1.8 -2)" />
                </g>
              </g>
            </g>
          );
        })}
        <!-- A blank pin for a newcomer whose country has none yet; the script fills it in and drops it in place. -->
        <g class="visit-pin" style="display: none" data-visit-template>
          <g class="visit-pin-drop">
            <g class="visit-pin-body">
              <line class="visit-pin-hit" data-needle />
              <circle class="visit-pin-shadow" r="2.5" />
              <line class="visit-pin-needle" data-needle />
              <line class="visit-pin-glint" data-needle />
              <g data-ball>
                <circle class="visit-pin-head" r="5" />
                <ellipse class="visit-pin-shine" cx="-1.8" cy="-2" rx="1.6" ry="1.1" transform="rotate(-30 -1.8 -2)" />
              </g>
            </g>
          </g>
        </g>
        <g class="fun-layer">
          {funPlaces.map((place, index) => (
            <g class="fun-pin" data-pin={index}>
              <g class="fun-drop" style={`--i: ${index}`}>
                <circle class="fun-pulse" r="5" />
                <circle r="5" />
                <text x={place.left ? -10 : 10} y="4" text-anchor={place.left ? "end" : "start"}
                  data-en={funLabel(place).en} data-zh={funLabel(place).zh}>{funLabel(place).en}</text>
              </g>
            </g>
          ))}
        </g>
      </svg>
      <!-- A little note that wiggles now and then, inviting a click; once open it offers to put the pins away. -->
      <button type="button" class="fun-toggle" aria-pressed="false" data-fun-toggle>
        <span class="fun-teaser">
          <span class="fun-spark" aria-hidden="true">✦</span>
          <LocalizedText en="Psst… want a fun fact about Guanhao?" zh="嘘，想知道王冠豪的一个小秘密吗？" />
        </span>
        <span class="fun-close">
          <LocalizedText en="Okay, tuck them away" zh="好啦，收起来" />
          <svg class="fun-close-icon" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 3l6 6M9 3l-6 6" /></svg>
        </span>
      </button>
      <div class="map-tooltip" data-map-tooltip hidden></div>
      <script type="application/json" data-globe-data set:html={globeData}></script>
    </figure>
  </section>
</BaseLayout>

<script>
  import { geoDistance, geoGraticule10, geoOrthographic, geoPath } from "d3-geo";

  const graticule = geoGraticule10();

  // Dragging turns the globe; the wheel or a pinch zooms it. Hovering (or tapping) a visited country shows its
  // name and visitor count beside the pointer.
  const setupGlobe = () => {
    const map = document.querySelector<HTMLElement>("[data-visitor-map]");
    const globe = map?.querySelector<SVGSVGElement>("[data-globe]");
    const tooltip = map?.querySelector<HTMLElement>("[data-map-tooltip]");
    if (!map || !globe || !tooltip || map.dataset.bound) return;
    map.dataset.bound = "true";

    const data = JSON.parse(map.querySelector("[data-globe-data]")!.textContent!);
    const projection = geoOrthographic().scale(data.scale).rotate(data.rotate);
    const path = geoPath(projection).digits(1);
    const sphere = globe.querySelector("[data-globe-sphere]")!;
    const lines = globe.querySelector("[data-globe-graticule]")!;
    const shapes = [...globe.querySelectorAll<SVGPathElement>("[data-shape]")];
    const visitPins = [...globe.querySelectorAll<SVGGElement>("[data-visit]")];
    const pins = [...globe.querySelectorAll<SVGGElement>("[data-pin]")];
    let touched = false;
    const funToggle = map.querySelector<HTMLButtonElement>("[data-fun-toggle]")!;
    let rotation: [number, number] = data.rotate;
    let zoom = 1;
    let frame = 0;
    // A flick keeps the globe spinning and slowing down, and the wheel eases toward its zoom instead of jumping.
    let targetZoom = 1;
    let velocity: [number, number] = [0, 0]; // degrees per millisecond
    let lastMove = 0;
    let previous = 0;
    let gliding = 0;
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    // Pointers on the globe: one drags, two pinch.
    const pointers = new Map<number, { x: number; y: number }>();

    // Only pins on the side facing the viewer show.
    const placePin = (pin: SVGGElement, at: [number, number]) => {
      const facing = geoDistance(at, [-rotation[0], -rotation[1]]) < Math.PI / 2;
      pin.style.visibility = facing ? "" : "hidden";
      if (!facing) return;
      const [x, y] = projection(at)!;
      pin.setAttribute("transform", `translate(${x.toFixed(1)} ${y.toFixed(1)})`);
      // A visitor pin stands out of the globe with a slight lean (see pinTop on the server).
      const ball = pin.querySelector("[data-ball]");
      if (!ball) return;
      const [cx, cy] = projection.translate();
      const [lx, ly] = pin.dataset.lean!.split(" ").map(Number);
      const top = [data.pinHeight * (x - cx) / projection.scale() + lx, data.pinHeight * (y - cy) / projection.scale() + ly];
      ball.setAttribute("transform", `translate(${top[0].toFixed(2)} ${top[1].toFixed(2)})`);
      pin.querySelectorAll("[data-needle]").forEach((needle) => {
        needle.setAttribute("x2", top[0].toFixed(2));
        needle.setAttribute("y2", top[1].toFixed(2));
      });
    };
    const render = () => {
      frame = 0;
      projection.rotate(rotation).scale(data.scale * zoom);
      sphere.setAttribute("d", path({ type: "Sphere" }) ?? "");
      lines.setAttribute("d", path(graticule) ?? "");
      shapes.forEach((shape) => shape.setAttribute("d", path(data.geometries[Number(shape.dataset.shape)]) ?? ""));
      visitPins.forEach((pin) => placePin(pin, data.visits[Number(pin.dataset.visit)]));      pins.forEach((pin) => placePin(pin, data.pins[Number(pin.dataset.pin)]));
    };
    const redraw = () => {
      if (!frame && !gliding) frame = requestAnimationFrame(render);
    };
    const turn = (dx: number, dy: number) => {
      rotation = [rotation[0] + dx, Math.max(-90, Math.min(90, rotation[1] + dy))];
    };
    const glide = (now: number) => {
      const dt = previous ? Math.min(now - previous, 64) : 16;
      previous = now;
      if (!pointers.size) {
        turn(velocity[0] * dt, velocity[1] * dt);
        if (Math.abs(rotation[1]) === 90) velocity[1] = 0;
        const decay = Math.exp(-dt / 325);
        velocity = [velocity[0] * decay, velocity[1] * decay];
        if (Math.hypot(...velocity) < 0.002) velocity = [0, 0];
      }
      zoom += (targetZoom - zoom) * (1 - Math.exp(-dt / 90));
      if (Math.abs(targetZoom - zoom) < 0.001) zoom = targetZoom;
      render();
      gliding = velocity[0] || velocity[1] || zoom !== targetZoom ? requestAnimationFrame(glide) : 0;
      if (!gliding) previous = 0;
    };
    const startGlide = () => {
      if (reducedMotion.matches) {
        velocity = [0, 0];
        zoom = targetZoom;
        redraw();
      } else if (!gliding) {
        cancelAnimationFrame(frame);
        frame = 0;
        gliding = requestAnimationFrame(glide);
      }
    };
    // Match the view to the globe's box (wider on desktop, square on phones), with the globe in the middle.
    const fit = () => {
      const bounds = globe.getBoundingClientRect();
      const width = data.size * bounds.width / bounds.height;
      globe.setAttribute("viewBox", `0 0 ${width} ${data.size}`);
      projection.translate([width / 2, data.size / 2]);
      redraw();
    };
    // Turns the globe until a place faces the viewer, the short way round, easing in and out.
    let flight = 0;
    const flyTo = (at: [number, number]) => {
      cancelAnimationFrame(flight);
      velocity = [0, 0];
      const from = rotation;
      const turnBy = [((-at[0] - from[0]) % 360 + 540) % 360 - 180, -at[1] - from[1]];
      const start = performance.now();
      const duration = reducedMotion.matches ? 0 : 1100;
      const step = (now: number) => {
        const t = duration ? Math.min(1, (now - start) / duration) : 1;
        const eased = t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2;
        rotation = [from[0] + turnBy[0] * eased, from[1] + turnBy[1] * eased];
        render();
        flight = t < 1 ? requestAnimationFrame(step) : 0;
      };
      flight = requestAnimationFrame(step);
    };
    const showPin = (index: number) => {
      pins.forEach((pin, i) => pin.classList.toggle("is-current", i === index));
      flyTo(data.pins[index]);
    };

    funToggle.addEventListener("click", () => {
      const on = !map.classList.contains("is-fun");
      map.classList.toggle("is-fun", on);
      funToggle.setAttribute("aria-pressed", String(on));
      if (on) showPin(0);
    });

    // A pinch follows the fingers directly; the wheel eases.
    const zoomBy = (factor: number, direct = false) => {
      targetZoom = Math.min(8, Math.max(1, targetZoom * factor));
      if (direct) {
        zoom = targetZoom;
        redraw();
      } else {
        startGlide();
      }
    };
    const spread = () => {
      const [a, b] = [...pointers.values()];
      return Math.hypot(a.x - b.x, a.y - b.y);
    };

    globe.addEventListener("pointerdown", (event) => {
      globe.setPointerCapture(event.pointerId);
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      globe.classList.add("is-dragging");
      tooltip.hidden = true;
      // Touching a spinning globe catches it.
      velocity = [0, 0];
      cancelAnimationFrame(flight);
      lastMove = event.timeStamp;
      touched = true;
    });

    globe.addEventListener("pointermove", (event) => {
      const last = pointers.get(event.pointerId);
      if (!last) return;
      if (pointers.size === 1) {
        // Degrees per screen pixel, so the spot under the pointer roughly follows it.
        const step = (180 / Math.PI) / (data.scale * zoom) * (data.size / globe.getBoundingClientRect().height);
        const dx = (event.clientX - last.x) * step;
        const dy = -(event.clientY - last.y) * step;
        turn(dx, dy);
        // Recent moves count most, so the spin on release matches the end of the flick.
        const dt = Math.max(event.timeStamp - lastMove, 1);
        velocity = [0.8 * dx / dt + 0.2 * velocity[0], 0.8 * dy / dt + 0.2 * velocity[1]];
        lastMove = event.timeStamp;
        pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
        redraw();
      } else {
        const before = spread();
        pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
        velocity = [0, 0];
        if (before > 0) zoomBy(spread() / before, true);
      }
    });

    const release = (event: PointerEvent) => {
      pointers.delete(event.pointerId);
      if (pointers.size) return;
      globe.classList.remove("is-dragging");
      // Holding still before letting go means no flick. Very fast flicks are capped so the globe stays readable.
      const speed = Math.hypot(...velocity);
      if (event.timeStamp - lastMove > 80 || event.type === "pointercancel") velocity = [0, 0];
      else if (speed > 1.5) velocity = [velocity[0] * 1.5 / speed, velocity[1] * 1.5 / speed];
      if (velocity[0] || velocity[1]) startGlide();
    };
    globe.addEventListener("pointerup", release);
    globe.addEventListener("pointercancel", release);

    globe.addEventListener("wheel", (event) => {
      event.preventDefault();
      zoomBy(Math.exp(-event.deltaY * 0.0015));
    }, { passive: false });

    map.addEventListener("pointermove", (event) => {
      const place = (event.target as Element).closest<SVGElement>("[data-country]");
      if (!place || pointers.size) {
        tooltip.hidden = true;
        return;
      }
      const zh = document.documentElement.lang === "zh-CN";
      const count = Number(place.dataset.count);
      const name = zh ? place.dataset.nameZh : place.dataset.nameEn;
      tooltip.textContent = zh ? `${name} · ${count} 位访客` : `${name} · ${count} ${count === 1 ? "visitor" : "visitors"}`;
      const bounds = map.getBoundingClientRect();
      tooltip.style.left = `${event.clientX - bounds.left}px`;
      tooltip.style.top = `${event.clientY - bounds.top}px`;
      tooltip.hidden = false;
    });
    map.addEventListener("pointerleave", () => (tooltip.hidden = true));

    // Greet the newcomer by the country of their clock's time zone. Once the page has settled the globe turns to
    // that country and it glows, unless they've already taken hold of the globe.
    const youCode = data.zones[Intl.DateTimeFormat().resolvedOptions().timeZone];
    const you = data.youPlaces[youCode];
    const hello = document.querySelector<HTMLElement>("[data-visitor-hello]");

    // The map's numbers were fetched when the site was last built. A newcomer who first came by after that isn't in
    // them yet, so their own visit is added here, on their screen only, until the next build counts it for real.
    let addedYou = false;
    const addMyVisit = () => {
      let firstVisit = 0;
      try {
        firstVisit = Number(localStorage.getItem("guanhao-visited"));
      } catch {
        return;
      }
      if (!you || addedYou || !(firstVisit > data.builtAt)) return;
      addedYou = true;
      // They are the first, so "no visitors yet" no longer holds.
      document.querySelector<HTMLElement>("[data-no-visitors]")?.remove();
      const box =globe.querySelector<SVGGElement>(`[data-group-box="${you.group}"]`);
      if (box) {
        const total = Number(box.dataset.total) + 1;
        box.dataset.total = String(total);
        box.classList.add("is-visited");
        const shade = 0.2 + 0.5 * Math.log(1 + total) / Math.log(1 + Math.max(data.maxGroup, total));
        box.style.setProperty("--shade", shade.toFixed(2));
      }
      const existing = visitPins.find((pin) => pin.dataset.country === youCode);
      if (existing) {
        existing.dataset.count = String(Number(existing.dataset.count) + 1);
      } else {
        // A new pin, dropped in like the fun-fact ones.
        const template = globe.querySelector<SVGGElement>("[data-visit-template]")!;
        const pin = template.cloneNode(true) as SVGGElement;
        pin.removeAttribute("data-visit-template");
        pin.style.display = "";
        pin.classList.add("is-new");
        Object.assign(pin.dataset, {
          visit: String(data.visits.length), country: youCode, nameEn: you.en, nameZh: you.zh, count: "1",
          lean: you.lean.join(" "),
        });
        const size = 0.8 + 0.6 * Math.log(2) / Math.log(1 + Math.max(data.maxCount, 1));
        pin.querySelector<SVGGElement>(".visit-pin-body")!.style.setProperty("--size", size.toFixed(2));
        data.visits.push(you.at);
        template.before(pin);
        visitPins.push(pin);
      }
      redraw();
    };
    addMyVisit();
    // On the very first page the visit is recorded a moment after the page sets up.
    window.addEventListener("guanhao:first-visit", addMyVisit);
    if (you && hello) {
      const text = hello.querySelector<HTMLElement>("[data-hello-text]")!;
      const the = /^(United|Netherlands|Philippines|Bahamas|Gambia|Maldives|Czech|Dominican|Central African)/.test(you.en) ? "the " : "";
      text.dataset.en = `Hello, visitor from ${the}${you.en}!`;
      text.dataset.zh = `你好，来自${you.zh}的访客！`;
      const zh = document.documentElement.lang === "zh-CN";
      text.textContent = zh ? text.dataset.zh : text.dataset.en;
      hello.title = zh ? "根据你设备的时区推测，不会上传任何信息" : "Guessed from your device's time zone. Nothing is uploaded.";
      hello.hidden = false;
      window.setTimeout(() => {
        if (touched || map.classList.contains("is-fun")) return;
        flyTo(you.at);
        globe.querySelectorAll(`[data-group="${you.group}"]`).forEach((country) => country.classList.add("is-home"));
      }, 900);
    }

    fit();
    new ResizeObserver(fit).observe(globe);
  };

  setupGlobe();
  document.addEventListener("astro:page-load", setupGlobe);
</script>

<style>
  /* The page column shrinks to its content, so give the map the column's full width. */
  .visitors {
    width: min(852px, calc(100vw - 3rem));
  }

  .map-card {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 1rem;
    background: oklch(var(--b1));
  }

  .globe {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    cursor: grab;
    /* Vertical swipes still scroll the page on phones; sideways swipes turn the globe. */
    touch-action: pan-y;
    user-select: none;
  }

  @media (max-width: 640px) {
    .globe {
      aspect-ratio: 1;
    }
  }

  .globe.is-dragging {
    cursor: grabbing;
  }

  .globe-sphere {
    fill: oklch(var(--b2));
    stroke: color-mix(in srgb, currentColor 15%, transparent);
    stroke-width: 1;
  }

  .globe-graticule {
    fill: none;
    stroke: color-mix(in srgb, currentColor 7%, transparent);
    stroke-width: 0.5;
  }

  .country {
    fill: oklch(var(--b3));
    stroke: oklch(var(--b1));
    stroke-width: 0.5;
  }

  /* Visited countries take on the pins' red, deeper where more visitors came from. The shade stays light enough
     for the pins to stand out on it. */
  .country-group.is-visited .country {
    fill: color-mix(in oklch, var(--pin) calc(var(--shade) * 100%), oklch(var(--b3)));
    transition: fill 200ms ease;
  }

  /* Hovering any part of a visited country deepens all of it. */
  .country-group.is-visited:hover .country {
    fill: color-mix(in oklch, var(--pin) 85%, oklch(var(--b3)));
  }

  /* Visited places get a muted red pin, a little bigger where more visitors came from. */
  .globe {
    --pin: oklch(0.6 0.09 25);
  }

  .visit-pin {
    cursor: default;
    transition: opacity 300ms ease;
  }

  /* With the fun fact open, the visitor pins step back so the labels read clearly. */
  .map-card.is-fun .visit-pin {
    opacity: 0.3;
  }

  /* A newcomer's own new pin drops in from above. */
  .visit-pin.is-new .visit-pin-drop {
    animation: fun-drop 700ms cubic-bezier(0.34, 1.56, 0.64, 1) 1.4s both;
  }

  .visit-pin-body {
    transform: scale(var(--size));
    transition: transform 240ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .visit-pin:hover .visit-pin-body {
    transform: scale(calc(var(--size) * 1.3));
  }

  /* An invisible fat stroke from the tip to the ball, so the pin is easy to hover even though it's small. */
  .visit-pin-hit {
    stroke: transparent;
    stroke-width: 18;
    stroke-linecap: round;
    pointer-events: stroke;
  }

  .visit-pin-shadow {
    fill: black;
    opacity: 0.25;
    filter: blur(0.8px);
  }

  /* A steel needle: a grey line with a thin bright glint along it. */
  .visit-pin-needle,
  .visit-pin-glint {
    stroke-linecap: round;
  }

  .visit-pin-needle {
    stroke: #858585;
    stroke-width: 1.6;
  }

  .visit-pin-glint {
    stroke: #e6e6e6;
    stroke-width: 0.5;
  }

  .visit-pin-head {
    fill: url(#pin-ball);
  }

  .visit-pin-shine {
    fill: white;
    opacity: 0.7;
    pointer-events: none;
  }

  .pin-ball-light {
    stop-color: color-mix(in oklch, var(--pin) 45%, white);
  }

  .pin-ball-mid {
    stop-color: var(--pin);
  }

  .pin-ball-dark {
    stop-color: color-mix(in oklch, var(--pin) 55%, black);
  }

  /* The newcomer's own pin: the accent colour, a ripple where it goes in, and a label. */
  /* The greeting reads as something I say to the newcomer: a speech bubble that pops in once the page knows where
     they are. The hand in it waves a couple of times. */
  .visitor-hello {
    display: flex;
    justify-content: center;
    margin: -1.25rem 0 2rem;
    cursor: help;
  }

  .visitor-hello[hidden] {
    display: none;
  }

  .hello-bubble {
    position: relative;
    margin: 0;
    padding: 0.3rem 1.1rem 0.4rem;
    font-family: var(--font-hand);
    font-size: 1.6rem;
    line-height: 1.3;
    background: oklch(var(--b1));
    border: 1px solid oklch(var(--bc) / 0.12);
    border-radius: 1.25rem;
    box-shadow: 0 12px 28px -18px rgba(60, 38, 28, 0.45);
    transform-origin: bottom left;
    animation: hello-in 600ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  /* The tail: a small square turned on its corner, half tucked under the bubble's bottom edge near the left. */
  .hello-bubble::before {
    content: "";
    position: absolute;
    left: 1.5rem;
    bottom: -0.4rem;
    width: 0.75rem;
    height: 0.75rem;
    background: inherit;
    border-right: 1px solid oklch(var(--bc) / 0.12);
    border-bottom: 1px solid oklch(var(--bc) / 0.12);
    border-radius: 0 0 0.15rem 0;
    transform: rotate(45deg);
  }

  @keyframes hello-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.9);
    }
  }

  .hello-wave {
    display: inline-block;
    margin-left: 0.3rem;
    transform-origin: 70% 80%;
    animation: hello-wave 1.4s ease-in-out 600ms 2;
  }

  @keyframes hello-wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    10%, 30% { transform: rotate(16deg); }
    20%, 40% { transform: rotate(-10deg); }
  }

  /* Their own country glows for a moment once the globe has turned to it. */
  .country.is-home {
    animation: home-glow 2.4s ease-in-out 2;
  }

  @keyframes home-glow {
    50% { fill: color-mix(in oklch, oklch(var(--s)) 55%, oklch(var(--b3))); }
  }

  /* A sticky note in handwriting, tilted a little. Every few seconds it gives a small wiggle to catch the eye. */
  .fun-toggle {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    max-width: calc(100% - 1.7rem);
    padding: 0.35rem 0.9rem 0.25rem;
    border: 1px dashed oklch(var(--s));
    border-radius: 0.6rem;
    background: color-mix(in oklch, oklch(var(--s)) 14%, oklch(var(--b1)));
    box-shadow: 0 8px 18px -12px color-mix(in srgb, currentColor 45%, transparent);
    font-family: var(--font-hand);
    font-size: 1.2rem;
    line-height: 1.2;
    text-align: left;
    transform: rotate(-2deg);
    transform-origin: 90% 50%;
    animation: fun-wiggle 4.5s ease-in-out 1.5s infinite;
    transition: transform 320ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 320ms ease;
  }

  .fun-toggle:hover {
    animation: none;
    transform: rotate(0deg) scale(1.05);
    box-shadow: 0 12px 22px -12px color-mix(in srgb, currentColor 55%, transparent);
  }

  @keyframes fun-wiggle {
    0%, 82%, 100% { transform: rotate(-2deg); }
    86% { transform: rotate(-6deg) scale(1.04); }
    90% { transform: rotate(2deg) scale(1.04); }
    94% { transform: rotate(-4deg); }
  }

  .fun-spark {
    display: inline-block;
    margin-right: 0.2rem;
    color: oklch(var(--s));
    animation: fun-twinkle 1.8s ease-in-out infinite;
  }

  @keyframes fun-twinkle {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; }
    50% { transform: scale(0.6) rotate(45deg); opacity: 0.5; }
  }

  /* Once open, the note pops and turns into a quiet way to put the pins away. */
  .fun-close {
    display: none;
  }

  .fun-toggle[aria-pressed="true"] {
    border-style: solid;
    border-color: color-mix(in srgb, currentColor 15%, transparent);
    background: oklch(var(--b1));
    font-size: 1.05rem;
    opacity: 0.85;
    transform: rotate(0deg);
    animation: fun-burst 450ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .fun-toggle[aria-pressed="true"] .fun-teaser {
    display: none;
  }

  /* The close mark is drawn, not typed, so it sits centred beside the handwriting in a small round badge. */
  .fun-toggle[aria-pressed="true"] .fun-close {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .fun-close-icon {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    padding: 0.2rem;
    border-radius: 50%;
    background: color-mix(in srgb, currentColor 10%, transparent);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    transition: transform 240ms ease, background-color 240ms ease;
  }

  .fun-toggle:hover .fun-close-icon {
    transform: rotate(90deg);
    background: color-mix(in srgb, currentColor 18%, transparent);
  }

  @keyframes fun-burst {
    0% { transform: scale(0.7); opacity: 0; }
    60% { transform: scale(1.08); }
    100% { transform: scale(1); }
  }

  .fun-layer {
    display: none;
    pointer-events: none;
  }

  .map-card.is-fun .fun-layer {
    display: inline;
  }

  /* Each pin drops in from above and bounces, one after another. */
  .fun-drop {
    animation: fun-drop 700ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(500ms + var(--i) * 150ms);
  }

  @keyframes fun-drop {
    0% { transform: translateY(-48px); opacity: 0; }
    40% { opacity: 1; }
    100% { transform: translateY(0); }
  }

  .fun-pin circle {
    fill: oklch(var(--s));
    stroke: oklch(var(--b1));
    stroke-width: 2;
    transition: r 200ms ease;
  }

  .fun-pin.is-current circle {
    r: 7;
  }

  /* The current place sends out a ripple, on the globe and in the list below. */
  .fun-pin .fun-pulse {
    display: none;
    fill: none;
    stroke: oklch(var(--s));
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
  }

  .fun-pin.is-current .fun-pulse {
    display: inline;
    animation: fun-ripple 1.6s ease-out infinite;
  }

  @keyframes fun-ripple {
    from {
      opacity: 0.8;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3.2);
    }
  }

  /* A halo in the card's colour keeps the label readable over land and sea. */
  .fun-pin text {
    fill: oklch(var(--bc));
    font-size: 13px;
    font-weight: 600;
    paint-order: stroke;
    stroke: oklch(var(--b1));
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: reduce) {
    .fun-toggle,
    .fun-spark,
    .fun-drop,
    .visit-pin.is-new .visit-pin-drop,
    .fun-pin.is-current .fun-pulse,
    .hello-bubble,
    .hello-wave,
    .country.is-home {
      animation: none;
    }
  }

  .map-tooltip {
    position: absolute;
    z-index: 1;
    padding: 0.3rem 0.6rem;
    border-radius: 0.5rem;
    background: oklch(var(--bc));
    color: oklch(var(--b1));
    font-size: 0.8rem;
    white-space: nowrap;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 0.75rem));
  }
</style>
