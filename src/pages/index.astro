---
import BaseLayout from "../layouts/BaseLayout.astro";
import LocalizedText from "../components/LocalizedText.astro";
import GameCollage from "../components/GameCollage.astro";
import HomeHero from "../components/HomeHero.astro";
---

<BaseLayout>
  <HomeHero slot="hero">
  <div id="about">
    <div class="hero-layer hero-title font-bold font-heading" data-depth="1" data-intro="name"><LocalizedText en="I'm Guanhao Wang" zh="我是王冠豪" /></div>
    <!-- The fields are typed out and deleted one after another on their own line. The static list stays for
         screen readers, and is what shows without JavaScript or with reduced motion. -->
    <div class="hero-layer hero-subtitle py-3 font-bold font-heading" data-depth="0.6" data-intro="subtitle">
      <span class="subtitle-lead"><LocalizedText en="A Computer Science student focused on" zh="计算机科学专业学生，专注于" /></span>
      <span class="typewriter" data-typewriter><LocalizedText en="Game Design / Game Development" zh="游戏设计 / 游戏开发" /></span>
    </div>
    <div class="hero-layer hero-tagline py-2" data-depth="0.3" data-intro="tagline">
      <text>
        <LocalizedText
          en="I love video games and interactive experiences, and I enjoy designing them. Through programming and design, I hope to turn that passion into creations of my own."
          zh="我热爱电子游戏与交互体验，也享受设计它们的过程。我希望通过编程与设计，将这份热爱转化为自己的作品。"
        />
      </text>
    </div>
    <div class="hero-layer pt-4" data-depth="0.15" data-intro="cta">
      <a class="btn btn-primary rounded-full" href="/portfolio"><LocalizedText en="View Portfolio" zh="查看作品集" /><span aria-hidden="true">→</span></a>
    </div>
  </div>
  </HomeHero>

  <section id="games" class="scroll-mt-20 pt-12">
    <div class="text-3xl w-full font-bold font-heading" data-reveal>
      <!-- A line-drawn controller beside the heading.
           The script places it next to the heading text, which changes with the language. -->
      <span class="doodle-heading">
        <LocalizedText en="My Favorite Video Games" zh="我最喜欢的电子游戏作品" />
        <svg class="doodle-stroke" aria-hidden="true">
          <g class="doodle-pad">
            <path d="M6.5 30C8.5 30 10 29 11.1 27.4L14 23H34L36.9 27.4C38 29 39.5 30 41.5 30C44.5 30 47.1 27.5 46.5 24L45 16C44 10 40 6 34 6H14C8 6 4 10 3 16L1.5 24C0.9 27.5 3.5 30 6.5 30Z" />
            <path d="M13 12.5v6M10 15.5h6" />
            <circle cx="32.5" cy="13" r="1.2" />
            <circle cx="37.5" cy="18" r="1.2" />
          </g>
        </svg>
      </span>
    </div>
    <GameCollage />
  </section>
</BaseLayout>

<script>
  import { gsap, ScrollTrigger } from "../scripts/smooth-scroll";
  import { DrawSVGPlugin } from "gsap/DrawSVGPlugin";
  import { afterCurtain } from "../scripts/curtain";

  gsap.registerPlugin(DrawSVGPlugin);

  // About Me lives on the right of the hero and is one sequence, built on GSAP:
  //  1. The hero starts without it. Shortly after the page opens it plays in by itself: the name rises in,
  //     then "A Computer Science student focused on" rises in and the fields start typing out and deleting one after another behind a caret,
  //     the tagline appears word by word, and the View Portfolio button comes in last.
  //  2. Once the hero scrolls away, the lines drift up at different speeds and fade away as My Favorite Video Games arrives.
  //  3. The controller doodle beside My Favorite Video Games draws itself in.
  // Steps 2 and 3 are scrubbed, so scrolling back up plays them in reverse.

  // The letters live in a separate span next to the original text, so the language script can keep
  // rewriting the original without wiping out the animation.
  const cjk = /[\p{Script=Han}　-〿＀-￯]/u;
  const splitIntoLetters = (original: HTMLElement) => {
    const text = (document.documentElement.lang === "zh-CN" ? original.dataset.zh : original.dataset.en) ?? "";
    const graphemes = "Segmenter" in Intl
      ? [...new Intl.Segmenter(undefined, { granularity: "grapheme" }).segment(text)].map((part) => part.segment)
      : Array.from(text);
    const target = document.createElement("span");
    const letters: HTMLElement[] = [];
    const words: HTMLElement[] = [];
    let word: HTMLElement | undefined;

    // Separate letters lose the font's kerning (e.g. "Wa"), so record where each character sits in the original,
    // kerned text and match it below.
    const textNode = original.firstChild;
    const kerned: DOMRect[] = [];
    if (original.textContent === text && textNode?.nodeType === Node.TEXT_NODE) {
      const range = document.createRange();
      let offset = 0;
      graphemes.forEach((grapheme) => {
        if (!/\s/.test(grapheme)) {
          range.setStart(textNode, offset);
          range.setEnd(textNode, offset + grapheme.length);
          kerned.push(range.getBoundingClientRect());
        }
        offset += grapheme.length;
      });
    }

    original.style.display = "none";
    original.after(target);
    let at = 0;
    graphemes.forEach((grapheme) => {
      const start = at;
      at += grapheme.length;
      if (/\s/.test(grapheme)) {
        target.append(grapheme);
        word = undefined;
        return;
      }
      // Words never break mid-word. Chinese has no spaces, so each character is its own word and lines can wrap.
      const own = cjk.test(grapheme);
      if (!word || own) {
        word = document.createElement("span");
        word.className = "intro-word";
        target.append(word);
        words.push(word);
      }
      const span = document.createElement("span");
      span.textContent = grapheme;
      span.dataset.at = String(start);
      span.className = "intro-char";
      letters.push(span);
      word.append(span);
      if (own) word = undefined;
    });

    // Nudge each letter onto its kerned position (left to right, so earlier nudges are already applied).
    if (kerned.length === letters.length) {
      const firstTop = letters[0]?.getBoundingClientRect().top ?? 0;
      letters.forEach((letter, index) => {
        const placed = letter.getBoundingClientRect();
        const sameLine = Math.abs((placed.top - firstTop) - (kerned[index].top - kerned[0].top)) < 4;
        if (sameLine) letter.style.marginLeft = `${kerned[index].left - placed.left}px`;
      });
    }

    const restore = () => {
      target.remove();
      original.style.display = "";
    };
    return { text, letters, words, restore };
  };

  const clamp = (value: number) => Math.min(1, Math.max(0, value));
  const easeOut = (t: number) => 1 - (1 - t) ** 3;

  // Where each phase sits along the intro (0 to 1), and how long the whole intro plays.
  const phases = {
    name: [0, 0.2],
    subtitle: [0.15, 0.35],
    tagline: [0.4, 0.85],
    cta: [0.85, 1],
  } as const;
  const introSeconds = 3;

  // The fields the subtitle types out, each in its own colour.
  const roles = [
    { en: "Game Design", zh: "游戏设计", color: "#C0643F" },
    { en: "Game Development", zh: "游戏开发", color: "#4F8C9A" },
  ];
  const typeMs = 100;
  const deleteMs = 50;
  const holdMs = 2200;
  const gapMs = 400;

  // Types a role out, holds it, deletes it, and moves on to the next one, forever. Returns a stop function.
  const startTypewriter = (typed: HTMLElement, caret: HTMLElement) => {
    const chinese = document.documentElement.lang === "zh-CN";
    let role = 0;
    let length = 0;
    let deleting = false;
    let timer = 0;
    const step = () => {
      const { color } = roles[role];
      const letters = Array.from(chinese ? roles[role].zh : roles[role].en);
      typed.style.color = caret.style.background = color;
      if (!deleting) {
        length += 1;
        typed.textContent = letters.slice(0, length).join("");
        if (length < letters.length) timer = window.setTimeout(step, typeMs);
        else {
          deleting = true;
          timer = window.setTimeout(step, holdMs);
        }
        return;
      }
      length -= 1;
      typed.textContent = letters.slice(0, length).join("");
      if (length > 0) timer = window.setTimeout(step, deleteMs);
      else {
        deleting = false;
        role = (role + 1) % roles.length;
        timer = window.setTimeout(step, gapMs);
      }
    };
    step();
    return () => clearTimeout(timer);
  };

  const spread = <T extends { start: number; end: number }>(group: T[], [from, to]: readonly number[], length: number) => {
    group.forEach((item, index) => {
      item.start = group.length > 1 ? from + (index * (to - from - length)) / (group.length - 1) : from;
      item.end = item.start + length;
    });
  };

  // Fit the My Favorite Video Games doodle to the heading text: the controller sits just right of the words.
  const layoutDoodle = (heading: HTMLElement) => {
    const svg = heading.querySelector<SVGSVGElement>(".doodle-stroke")!;
    const pad = svg.querySelector<SVGGElement>(".doodle-pad")!;
    const range = document.createRange();
    range.selectNodeContents(heading.querySelector("[data-en]")!);
    const box = heading.getBoundingClientRect();
    const text = range.getBoundingClientRect();
    const em = parseFloat(getComputedStyle(heading).fontSize);
    const left = text.left - box.left;
    const top = text.top - box.top;
    const { width: w, height: h } = text;

    // The controller (drawn in a 48 x 32 box) sits right of the words, centred on them and tilted a little.
    const scale = (1.3 * em) / 48;
    const tilt = -8;
    const padX = left + w + 0.45 * em;
    const padY = top + h / 2 - 16 * scale;
    pad.setAttribute("transform", `translate(${padX} ${padY}) scale(${scale}) rotate(${tilt} 24 16)`);

    svg.setAttribute("width", String(box.width + em));
    svg.setAttribute("height", String(box.height + em));
    svg.setAttribute("viewBox", `0 0 ${box.width + em} ${box.height + em}`);
  };

  let teardownAbout: (() => void) | undefined;
  let setupRun = 0;

  const setupAbout = async () => {
    teardownAbout?.();
    teardownAbout = undefined;
    // setupAbout runs on load and again on astro:page-load; only the latest run may finish setting up.
    const run = ++setupRun;
    const main = document.querySelector<HTMLElement>("main");
    const hero = document.querySelector<HTMLElement>("[data-home-hero]");
    const about = document.getElementById("about");
    const name = about?.querySelector<HTMLElement>('[data-intro="name"]');
    const subtitle = about?.querySelector<HTMLElement>('[data-intro="subtitle"]');
    const tagline = about?.querySelector<HTMLElement>('[data-intro="tagline"]');
    const cta = about?.querySelector<HTMLElement>('[data-intro="cta"]');
    const doodle = main?.querySelector<HTMLElement>(".doodle-heading");
    if (!main || !hero || !about || !name || !subtitle || !tagline || !cta || !doodle) return;
    main.dataset.introStarted = "true";

    // Nothing below the hero waits for this sequence.
    const finish = () => {
      if (main.dataset.introDone) return;
      main.dataset.introDone = "true";
      document.dispatchEvent(new Event("portfolio:intro-done"));
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      [name, subtitle, tagline, cta].forEach((element) => element.classList.add("is-revealed"));
      finish();
      // No animation, but the doodle still needs fitting to the heading.
      await document.fonts.ready;
      if (main.isConnected && run === setupRun) layoutDoodle(doodle);
      return;
    }

    // On a rebuild (language switch) the teardown has just put back the plain, fully visible lines. Keep them
    // hidden until the new letters are in place, or the whole intro flashes up while the fonts load.
    const rebuilding = name.classList.contains("is-revealed");
    if (rebuilding) [name, subtitle, tagline, cta].forEach((element) => { element.style.visibility = "hidden"; });

    // Letters are positioned from measured glyph widths, so wait for the web fonts (briefly) before measuring.
    // After a page change, also wait for the curtain to lift, or the intro plays behind it.
    await Promise.all([
      Promise.race([document.fonts.ready, new Promise((resolve) => setTimeout(resolve, 1500))]),
      afterCurtain(),
    ]);
    if (!main.isConnected || run !== setupRun) return;

    [name, subtitle, tagline, cta].forEach((element) => element.classList.add("is-revealed"));
    finish();
    // The name and the button rise in as a whole. Their inner parts move, so the exit below can still move the lines.
    const nameText = name.querySelector<HTMLElement>("[data-en]")!;
    const ctaButton = cta.querySelector<HTMLElement>("a")!;

    // The subtitle's lead rises in like the name; the typed fields replace the static list, which stays for screen readers.
    const lead = subtitle.querySelector<HTMLElement>(".subtitle-lead")!;
    const typewriter = subtitle.querySelector<HTMLElement>("[data-typewriter]")!;
    const roleList = typewriter.querySelector<HTMLElement>("[data-en]")!;
    const typed = document.createElement("span");
    const caret = document.createElement("span");
    typed.className = "typewriter-text";
    caret.className = "typewriter-caret";
    typed.setAttribute("aria-hidden", "true");
    caret.setAttribute("aria-hidden", "true");
    roleList.classList.add("sr-only");
    typewriter.append(typed, caret);
    let stopTyping: (() => void) | undefined;

    // The tagline's words appear one after another.
    const story = splitIntoLetters(tagline.querySelector<HTMLElement>("[data-en]")!);
    const words = story.words.map((element) => ({ element, start: 0, end: 0 }));
    spread(words, phases.tagline, 0.12);

    const render = (progress: number) => {
      const rise = easeOut(clamp((progress - phases.name[0]) / (phases.name[1] - phases.name[0])));
      nameText.style.opacity = String(rise);
      nameText.style.transform = `translateY(${(1 - rise) * 0.3}em)`;

      const leadRise = easeOut(clamp((progress - phases.subtitle[0]) / (phases.subtitle[1] - phases.subtitle[0])));
      lead.style.opacity = caret.style.opacity = String(leadRise);
      lead.style.transform = `translateY(${(1 - leadRise) * 0.3}em)`;
      if (!stopTyping && progress >= phases.subtitle[1]) stopTyping = startTypewriter(typed, caret);

      words.forEach(({ element, start, end }) => {
        element.style.opacity = String(easeOut(clamp((progress - start) / (end - start))));
      });

      const pop = easeOut(clamp((progress - phases.cta[0]) / (phases.cta[1] - phases.cta[0])));
      ctaButton.style.opacity = String(pop);
      ctaButton.style.transform = `translateY(${(1 - pop) * 0.6}em)`;
    };

    // 1. About Me plays in by itself, just after the portrait. A language switch shows it already finished.
    const state = { progress: rebuilding ? 1 : 0 };
    const intro = gsap.to(state, {
      progress: 1,
      duration: rebuilding ? 0 : introSeconds,
      delay: rebuilding ? 0 : 0.6,
      ease: "none",
      onUpdate: () => render(state.progress),
    });
    render(state.progress);
    if (rebuilding) [name, subtitle, tagline, cta].forEach((element) => { element.style.visibility = ""; });

    // 2. As the hero scrolls away, the lines drift up at different speeds and fade away (no blur: a blur filter repaints the text every frame).
    const layers = [...about.querySelectorAll<HTMLElement>(".hero-layer")];
    const exit = gsap.timeline({
      scrollTrigger: {
        trigger: hero,
        start: "bottom bottom",
        end: "bottom 40%",
        scrub: 0.4,
      },
    });
    layers.forEach((layer) => {
      const depth = Number(layer.dataset.depth ?? 0.5);
      exit.to(layer, { y: -140 * depth, opacity: 1 - 0.95 * depth, ease: "none" }, 0);
    });

    // 3. As My Favorite Video Games arrives, its controller doodle is drawn in: the outline, then the d-pad and buttons.
    //    Each piece gets time in proportion to its length, so the pen moves at an even speed.
    layoutDoodle(doodle);
    const strokes = [...doodle.querySelectorAll<SVGGeometryElement>(".doodle-pad path, .doodle-pad circle")];
    const lengths = strokes.map((stroke) => stroke.getTotalLength());
    const total = lengths.reduce((sum, length) => sum + length, 0) || 1;
    // Start undrawn: the from-values inside a scroll-linked timeline aren't applied until the first scroll.
    gsap.set(strokes, { drawSVG: "0%" });
    const draw = gsap.timeline({
      scrollTrigger: {
        trigger: doodle,
        start: "top 90%",
        end: "top 40%",
        scrub: 0.4,
        onRefresh: () => layoutDoodle(doodle),
      },
    });
    strokes.forEach((stroke, index) => {
      draw.fromTo(stroke, { drawSVG: "0%" }, { drawSVG: "100%", ease: "none", duration: lengths[index] / total });
    });

    // A language switch rewrites the text, so rebuild everything for the new language.
    const rebuild = () => setupAbout();
    document.addEventListener("portfolio:language-change", rebuild, { once: true });

    teardownAbout = () => {
      document.removeEventListener("portfolio:language-change", rebuild);
      [intro, exit, draw].forEach((animation) => {
        animation.scrollTrigger?.kill(true);
        animation.kill();
      });
      gsap.set(layers, { clearProps: "transform,opacity" });
      nameText.style.opacity = nameText.style.transform = "";
      lead.style.opacity = lead.style.transform = "";
      ctaButton.style.opacity = ctaButton.style.transform = "";
      gsap.set(strokes, { clearProps: "all" });
      stopTyping?.();
      typed.remove();
      caret.remove();
      roleList.classList.remove("sr-only");
      story.restore();
    };
  };

  setupAbout();
  // Astro fires astro:page-load on the first visit too, but only at window load. Setting up again then would
  // cut the intro short and show it already finished, so only a page that hasn't been set up yet gets set up.
  let setUpMain = document.querySelector("main");
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector("main");
    if (main === setUpMain) return;
    setUpMain = main;
    setupAbout();
  });
  document.addEventListener("astro:before-swap", () => {
    teardownAbout?.();
    teardownAbout = undefined;
  });
</script>

<style>
  .hero-title {
    font-size: calc(var(--about-text) * 2.6);
    line-height: 1.2;
  }

  .hero-subtitle {
    font-size: calc(var(--about-text) * 1.6);
    line-height: 1.35;
  }

  .hero-tagline {
    font-size: var(--about-text);
    line-height: 1.5;
  }

  /* A smaller lead line, so it fits the narrow column in one line; the typed field below stays large. */
  .subtitle-lead {
    display: block;
    font-size: 0.7em;
  }

  /* The typed field gets its own line, so typing and deleting never rewraps the lead or shifts the tagline. */
  .typewriter {
    display: block;
  }

  /* A thin caret after the typed field, in the field's colour (set by the script). */
  .hero-subtitle :global(.typewriter-caret) {
    display: inline-block;
    width: 0.09em;
    height: 1em;
    margin-left: 0.08em;
    vertical-align: -0.12em;
    background: oklch(var(--p));
    animation: caret-blink 0.9s steps(1) infinite;
  }

  @keyframes caret-blink {
    50% {
      visibility: hidden;
    }
  }

  /* The heading leaves room on its right for the controller; the doodle's SVG is laid over it by the script. */
  .doodle-heading {
    position: relative;
    display: inline-block;
    padding-right: 1.9em;
  }

  .doodle-stroke {
    position: absolute;
    top: 0;
    left: 0;
    overflow: visible;
    pointer-events: none;
  }

  .doodle-stroke :is(path, circle) {
    fill: none;
    stroke: oklch(var(--p));
    stroke-linecap: round;
    stroke-linejoin: round;
    /* The controller is drawn scaled; keep its line weight in screen pixels. */
    vector-effect: non-scaling-stroke;
    stroke-width: 3;
  }

  .doodle-pad :is(path, circle) {
    stroke-width: 2.5;
  }
</style>
