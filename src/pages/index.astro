---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import ExpandableSection from "../components/ExpandableSection.astro";
import LocalizedText from "../components/LocalizedText.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1"><LocalizedText en="Hey there 👋" zh="你好 👋" /></div>
    <div class="text-5xl font-bold"><LocalizedText en="I'm Guanhao Wang" zh="我是 Guanhao Wang" /></div>
    <div class="text-3xl py-3 font-bold"><LocalizedText en="Computer Science Student & Game Developer" zh="计算机科学专业学生与游戏开发者" /></div>
    <div class="py-2">
      <text class="text-lg">
        <LocalizedText
          en="I build games and interactive experiences through programming and design. Here you can explore my work and learn more about my background."
          zh="我通过编程与设计创作游戏和交互体验。你可以在这里了解我的作品和背景。"
        />
      </text>
    </div>
    <div class="mt-8">
      <a class="btn btn-primary" href="/projects"><LocalizedText en="View my projects" zh="查看我的项目" /></a>
      <a href="/cv" class="btn btn-outline btn-primary ml-5">
        <LocalizedText en="View my resume" zh="查看我的简历" />
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2"><LocalizedText en="My last projects" zh="近期项目" /></div>
  </div>

  <HorizontalCard
    title="Seafloor Revival"
    projectId="seafloor-revival"
    img="/seafloor-revival.jpg"
    desc="A 2.5D underwater base building game made for GMTK Game Jam 2025. Lead a sea hare civilization, gather resources, unlock technology, and rebuild through recurring pollution disasters."
    descZh="为 GMTK Game Jam 2025 制作的 2.5D 海底基地建造游戏。带领海兔文明采集资源、解锁科技，在循环来袭的污染灾难中重建家园。"
    url="https://nikolai16.itch.io/seafloor-revival"
    category="game-jam"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Mask"
    projectId="mask"
    img="https://storage-v4.globalgamejam.org/files/styles/sidebar_full/s3/games/2026/832124/featured/6_1.png?VersionId=WijEEmYmB.AiE8a9MTHJh1C9mFAtUIJy&amp;itok=Jt2fWUhO"
    desc="A 2D platformer made for Global Game Jam 2026. Explore the roles we take on in life and peel away layers of masks to discover the self beneath."
    descZh="为 Global Game Jam 2026 制作的 2D 平台跳跃游戏。探索人生中被赋予的多重角色，揭开层层面具，寻找真实的自我。"
    url="https://globalgamejam.org/games/2026/mask-6-4"
    category="game-jam"
  />
  <ExpandableSection closedLabel="More projects" openLabel="Show less" closedLabelZh="更多项目">
    <div class="divider my-0"></div>
    <HorizontalCard
      title="Demo Project 3"
      projectId="demo-project-3"
      img="/post_img.webp"
      desc="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
      url="#"
    />
  </ExpandableSection>
</BaseLayout>
