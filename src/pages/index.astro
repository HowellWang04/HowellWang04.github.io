---
import BaseLayout from "../layouts/BaseLayout.astro";
import LocalizedText from "../components/LocalizedText.astro";
import GameCollage from "../components/GameCollage.astro";
import HomeHero from "../components/HomeHero.astro";
import PlayWithMe from "../components/PlayWithMe.astro";
import Hobbies from "../components/Hobbies.astro";
import Skills from "../components/Skills.astro";
---

<BaseLayout>
  <HomeHero slot="hero">
  <div id="about" class="about-card">
    <div class="hero-title font-bold font-heading" data-intro="name"><LocalizedText en="I'm Guanhao Wang" zh="我是王冠豪" /></div>
    <!-- The fields are typed out and deleted one after another on their own line. The static list stays for
         screen readers, and is what shows without JavaScript or with reduced motion. -->
    <div class="hero-subtitle py-3 font-bold font-heading" data-intro="subtitle">
      <span class="subtitle-lead"><LocalizedText en="A Computer Science student focused on" zh="计算机科学专业学生，专注于" /></span>
      <span class="typewriter" data-typewriter><LocalizedText en="Game Design / Game Development" zh="游戏设计 / 游戏开发" /></span>
    </div>
    <div class="hero-tagline py-2" data-intro="tagline">
      <text>
        <LocalizedText
          en="I'm passionate about video games and interactive experiences, and I enjoy designing them. Through programming and design, I hope to turn that passion into creations of my own."
          zh="我热爱电子游戏与交互体验，也享受设计它们的过程。我希望通过编程与设计，将这份热爱转化为自己的作品。"
        />
      </text>
    </div>
    <div class="pt-4" data-intro="cta">
      <a class="btn btn-primary rounded-full" href="/portfolio"><LocalizedText en="View Portfolio" zh="查看作品集" /><span aria-hidden="true">→</span></a>
    </div>
  </div>
  </HomeHero>

  <Skills />

  <section id="games" class="scroll-mt-20 pt-12">
    <!-- Above the game photos, which drop in from higher up while the doodle is being drawn. -->
    <div class="relative z-[3] text-3xl w-full font-bold font-heading" data-reveal>
      <!-- A highlighter swipe behind the heading, then a line-drawn controller beside it (two separate strokes).
           The script fits both to the heading text, which changes with the language. -->
      <span class="doodle-heading">
        <LocalizedText en="My Favorite Video Games" zh="我最喜欢的电子游戏作品" />
        <svg class="doodle-stroke" aria-hidden="true">
          <path class="doodle-line" />
          <g class="doodle-icon">
            <path d="M6.5 30C8.5 30 10 29 11.1 27.4L14 23H34L36.9 27.4C38 29 39.5 30 41.5 30C44.5 30 47.1 27.5 46.5 24L45 16C44 10 40 6 34 6H14C8 6 4 10 3 16L1.5 24C0.9 27.5 3.5 30 6.5 30Z" />
            <path d="M13 12.5v6M10 15.5h6" />
            <circle cx="32.5" cy="13" r="1.2" />
            <circle cx="37.5" cy="18" r="1.2" />
          </g>
        </svg>
      </span>
    </div>
    <GameCollage />
  </section>

  <PlayWithMe />
  <Hobbies />
</BaseLayout>

<script>
  import { gsap, ScrollTrigger } from "../scripts/smooth-scroll";
  import { DrawSVGPlugin } from "gsap/DrawSVGPlugin";

  gsap.registerPlugin(DrawSVGPlugin);

  // About Me lives on the right of the hero and is one sequence, built on GSAP:
  //  1. The hero starts without it. Shortly after the page opens it plays in by itself: the name rises in,
  //     then "A Computer Science student focused on" rises in and the fields start typing out and deleting one after another behind a caret,
  //     the tagline rises in, and the View Portfolio button comes in last.
  //  2. Once the hero scrolls away, the note the text sits on lifts off and fades away as My Favorite Video Games arrives.
  //  3. The doodles beside My Favorite Video Games, Find Me on Every Platform and Beyond Games draw themselves in.
  // Steps 2 and 3 are scrubbed, so scrolling back up plays them in reverse.

  const clamp = (value: number) => Math.min(1, Math.max(0, value));
  const easeOut = (t: number) => 1 - (1 - t) ** 3;

  // Where each phase sits along the intro (0 to 1), and how long the whole intro plays.
  const phases = {
    name: [0, 0.2],
    subtitle: [0.15, 0.35],
    tagline: [0.3, 0.55],
    cta: [0.5, 0.7],
  } as const;
  const introSeconds = 2;

  // The fields the subtitle types out, each in its own colour.
  const roles = [
    { en: "Game Design", zh: "游戏设计", color: "#C0643F" },
    { en: "Game Development", zh: "游戏开发", color: "#4F8C9A" },
  ];
  const typeMs = 100;
  const deleteMs = 50;
  const holdMs = 2200;
  const gapMs = 400;

  // Types a role out, holds it, deletes it, and moves on to the next one, forever. Returns a stop function.
  const startTypewriter = (typed: HTMLElement, caret: HTMLElement) => {
    const chinese = document.documentElement.lang === "zh-CN";
    let role = 0;
    let length = 0;
    let deleting = false;
    let timer = 0;
    const step = () => {
      const { color } = roles[role];
      const letters = Array.from(chinese ? roles[role].zh : roles[role].en);
      typed.style.color = caret.style.background = color;
      if (!deleting) {
        length += 1;
        typed.textContent = letters.slice(0, length).join("");
        if (length < letters.length) timer = window.setTimeout(step, typeMs);
        else {
          deleting = true;
          timer = window.setTimeout(step, holdMs);
        }
        return;
      }
      length -= 1;
      typed.textContent = letters.slice(0, length).join("");
      if (length > 0) timer = window.setTimeout(step, deleteMs);
      else {
        deleting = false;
        role = (role + 1) % roles.length;
        timer = window.setTimeout(step, gapMs);
      }
    };
    step();
    return () => clearTimeout(timer);
  };

  // Fit a heading's doodle to its text: the highlighter runs behind the words and the icons (each drawn in a 48 x 32
  // box) sit in a row just right of them. Technical Skills has code brackets, My Favorite Video Games a controller,
  // Find Me on Every Platform a handheld, and Beyond Games a leaf on a plate, a dumbbell and two notes.
  const layoutDoodle = (heading: HTMLElement) => {
    const svg = heading.querySelector<SVGSVGElement>(".doodle-stroke")!;
    const line = svg.querySelector<SVGPathElement>(".doodle-line")!;
    const icons = [...svg.querySelectorAll<SVGGElement>(".doodle-icon")];
    const range = document.createRange();
    range.selectNodeContents(heading.querySelector("[data-en]")!);
    const box = heading.getBoundingClientRect();
    const em = parseFloat(getComputedStyle(heading).fontSize);
    // A long heading can wrap on a narrow screen, so measure each line of the words on its own.
    const lines: { left: number; right: number; top: number; bottom: number }[] = [];
    for (const rect of range.getClientRects()) {
      if (!rect.width) continue;
      const row = lines.find((line) => Math.abs(line.top - rect.top) < em / 2);
      if (row) {
        row.left = Math.min(row.left, rect.left);
        row.right = Math.max(row.right, rect.right);
        row.bottom = Math.max(row.bottom, rect.bottom);
      } else {
        lines.push({ left: rect.left, right: rect.right, top: rect.top, bottom: rect.bottom });
      }
    }
    if (!lines.length) return;

    // One swipe of a highlighter behind the lower part of each line: it starts a little before the words, rises a
    // touch as a hand drifts, and runs a little past the end.
    line.setAttribute("d", lines.map((row) => {
      const left = row.left - box.left;
      const w = row.right - row.left;
      const x = (fraction: number) => left + w * fraction;
      const y = row.top - box.top + (row.bottom - row.top) * 0.6;
      return `M ${x(0) - 0.25 * em} ${y + 0.06 * em}` +
        ` C ${x(0.35)} ${y + 0.02 * em}, ${x(0.7)} ${y - 0.04 * em}, ${x(1) + 0.2 * em} ${y - 0.1 * em}`;
    }).join(" "));

    // The icons sit right of the last line, centred on it, each tilted a little and alternately one way and the other.
    const last = lines[lines.length - 1];
    const scale = (1.3 * em) / 48;
    const tilts = [-8, 6, -4];
    const iconY = (last.top + last.bottom) / 2 - box.top - 16 * scale;
    icons.forEach((icon, index) => {
      const iconX = last.right - box.left + (0.45 + index * 1.6) * em;
      icon.setAttribute("transform", `translate(${iconX} ${iconY}) scale(${scale}) rotate(${tilts[index % 3]} 24 16)`);
    });

    svg.setAttribute("width", String(box.width + em));
    svg.setAttribute("height", String(box.height + em));
    svg.setAttribute("viewBox", `0 0 ${box.width + em} ${box.height + em}`);
  };

  let teardownAbout: (() => void) | undefined;
  let setupRun = 0;

  const setupAbout = async () => {
    teardownAbout?.();
    teardownAbout = undefined;
    // setupAbout runs on load and again on astro:page-load; only the latest run may finish setting up.
    const run = ++setupRun;
    const main = document.querySelector<HTMLElement>("main");
    const hero = document.querySelector<HTMLElement>("[data-home-hero]");
    const about = document.getElementById("about");
    const name = about?.querySelector<HTMLElement>('[data-intro="name"]');
    const subtitle = about?.querySelector<HTMLElement>('[data-intro="subtitle"]');
    const tagline = about?.querySelector<HTMLElement>('[data-intro="tagline"]');
    const cta = about?.querySelector<HTMLElement>('[data-intro="cta"]');
    const doodles = [...(main?.querySelectorAll<HTMLElement>(".doodle-heading") ?? [])];
    if (!main || !hero || !about || !name || !subtitle || !tagline || !cta) return;
    main.dataset.introStarted = "true";

    // Nothing below the hero waits for this sequence.
    const finish = () => {
      if (main.dataset.introDone) return;
      main.dataset.introDone = "true";
      document.dispatchEvent(new Event("portfolio:intro-done"));
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      [name, subtitle, tagline, cta].forEach((element) => element.classList.add("is-revealed"));
      finish();
      // No animation, but the doodles still need fitting to their headings.
      await document.fonts.ready;
      if (main.isConnected && run === setupRun) doodles.forEach(layoutDoodle);
      return;
    }

    // On a rebuild (language switch) the teardown has just put back the plain, fully visible lines. Keep them
    // hidden until the new text is in place, or the whole intro flashes up while the fonts load.
    const rebuilding = name.classList.contains("is-revealed");
    if (rebuilding) [name, subtitle, tagline, cta].forEach((element) => { element.style.visibility = "hidden"; });

    // The doodle is fitted to the heading's measured text, so wait for the web fonts (briefly) before measuring.
    await Promise.race([document.fonts.ready, new Promise((resolve) => setTimeout(resolve, 1500))]);
    if (!main.isConnected || run !== setupRun) return;

    [name, subtitle, tagline, cta].forEach((element) => element.classList.add("is-revealed"));
    finish();
    // The name and the button rise in as a whole. Their inner parts move, so the exit below can still move the lines.
    const nameText = name.querySelector<HTMLElement>("[data-en]")!;
    const ctaButton = cta.querySelector<HTMLElement>("a")!;

    // The subtitle's lead rises in like the name; the typed fields replace the static list, which stays for screen readers.
    const lead = subtitle.querySelector<HTMLElement>(".subtitle-lead")!;
    const typewriter = subtitle.querySelector<HTMLElement>("[data-typewriter]")!;
    const roleList = typewriter.querySelector<HTMLElement>("[data-en]")!;
    const typed = document.createElement("span");
    const caret = document.createElement("span");
    typed.className = "typewriter-text";
    caret.className = "typewriter-caret";
    typed.setAttribute("aria-hidden", "true");
    caret.setAttribute("aria-hidden", "true");
    roleList.classList.add("sr-only");
    typewriter.append(typed, caret);
    let stopTyping: (() => void) | undefined;

    // The tagline rises in as a whole, like the name.
    const taglineText = tagline.querySelector<HTMLElement>("[data-en]")!;

    const render = (progress: number) => {
      // The note of paper behind the text lands first.
      about.style.setProperty("--card", String(easeOut(clamp(progress / 0.15))));

      const rise = easeOut(clamp((progress - phases.name[0]) / (phases.name[1] - phases.name[0])));
      nameText.style.opacity = String(rise);
      nameText.style.transform = `translateY(${(1 - rise) * 0.3}em)`;

      const leadRise = easeOut(clamp((progress - phases.subtitle[0]) / (phases.subtitle[1] - phases.subtitle[0])));
      lead.style.opacity = caret.style.opacity = String(leadRise);
      lead.style.transform = `translateY(${(1 - leadRise) * 0.3}em)`;
      if (!stopTyping && progress >= phases.subtitle[1]) stopTyping = startTypewriter(typed, caret);

      const taglineRise = easeOut(clamp((progress - phases.tagline[0]) / (phases.tagline[1] - phases.tagline[0])));
      taglineText.style.opacity = String(taglineRise);
      taglineText.style.transform = `translateY(${(1 - taglineRise) * 0.3}em)`;

      const pop = easeOut(clamp((progress - phases.cta[0]) / (phases.cta[1] - phases.cta[0])));
      ctaButton.style.opacity = String(pop);
      ctaButton.style.transform = `translateY(${(1 - pop) * 0.6}em)`;
    };

    // 1. About Me plays in by itself, just after the portrait. A language switch shows it already finished.
    const state = { progress: rebuilding ? 1 : 0 };
    const intro = gsap.to(state, {
      progress: 1,
      duration: rebuilding ? 0 : introSeconds,
      delay: rebuilding ? 0 : 0.6,
      ease: "none",
      onUpdate: () => render(state.progress),
    });
    render(state.progress);
    if (rebuilding) [name, subtitle, tagline, cta].forEach((element) => { element.style.visibility = ""; });

    // 2. As the hero scrolls away, the note lifts off the page and fades away (no blur: a blur filter repaints the text every frame).
    const exit = gsap.timeline({
      scrollTrigger: {
        trigger: hero,
        start: "bottom bottom",
        end: "bottom 40%",
        scrub: 0.4,
      },
    });
    exit.to(about, { y: -90, opacity: 0, ease: "none" }, 0);

    // 3. As each doodled heading arrives, the highlighter swipe goes on first, then after a short lift of the pen the
    //    icons beside it, one after another: the outline, then the details. The pieces get time in proportion to
    //    their length, so the pen moves at an even speed, and it lifts briefly between icons.
    const strokes: SVGGeometryElement[] = [];
    const draws = doodles.map((doodle) => {
      layoutDoodle(doodle);
      const highlight = doodle.querySelector<SVGPathElement>(".doodle-line")!;
      const icons = [...doodle.querySelectorAll<SVGGElement>(".doodle-icon")].map((icon) =>
        [...icon.querySelectorAll<SVGGeometryElement>("path, circle")]);
      const pieces = icons.flat();
      strokes.push(highlight, ...pieces);
      const lengths = pieces.map((stroke) => stroke.getTotalLength());
      const total = lengths.reduce((sum, length) => sum + length, 0) || 1;
      // Start undrawn: the from-values inside a scroll-linked timeline aren't applied until the first scroll.
      gsap.set([highlight, ...pieces], { drawSVG: "0%" });
      const draw = gsap.timeline({
        scrollTrigger: {
          trigger: doodle,
          start: "top 90%",
          end: "top 40%",
          scrub: 0.4,
          onRefresh: () => layoutDoodle(doodle),
        },
      });
      draw.fromTo(highlight, { drawSVG: "0%" }, { drawSVG: "100%", ease: "power1.inOut", duration: 0.7 });
      draw.to({}, { duration: 0.15 });
      let index = 0;
      icons.forEach((icon, iconIndex) => {
        if (iconIndex) draw.to({}, { duration: 0.08 });
        icon.forEach((stroke) => {
          draw.fromTo(stroke, { drawSVG: "0%" }, { drawSVG: "100%", ease: "none", duration: lengths[index++] / total });
        });
      });
      return draw;
    });

    // A language switch rewrites the text, so rebuild everything for the new language.
    const rebuild = () => setupAbout();
    document.addEventListener("portfolio:language-change", rebuild, { once: true });

    teardownAbout = () => {
      document.removeEventListener("portfolio:language-change", rebuild);
      [intro, exit, ...draws].forEach((animation) => {
        animation.scrollTrigger?.kill(true);
        animation.kill();
      });
      gsap.set(about, { clearProps: "transform,opacity" });
      about.style.removeProperty("--card");
      nameText.style.opacity = nameText.style.transform = "";
      lead.style.opacity = lead.style.transform = "";
      taglineText.style.opacity = taglineText.style.transform = "";
      ctaButton.style.opacity = ctaButton.style.transform = "";
      gsap.set(strokes, { clearProps: "all" });
      stopTyping?.();
      typed.remove();
      caret.remove();
      roleList.classList.remove("sr-only");
    };
  };

  setupAbout();
  // Astro fires astro:page-load on the first visit too, but only at window load. Setting up again then would
  // cut the intro short and show it already finished, so only a page that hasn't been set up yet gets set up.
  let setUpMain = document.querySelector("main");
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector("main");
    if (main === setUpMain) return;
    setUpMain = main;
    setupAbout();
  });
  document.addEventListener("astro:before-swap", () => {
    teardownAbout?.();
    teardownAbout = undefined;
  });
</script>

<style>
  /* The About text sits on a note of paper, so its lines read as one block. */
  .about-card {
    position: relative;
    isolation: isolate;
    padding: calc(var(--about-text) * 1.7) calc(var(--about-text) * 1.6) calc(var(--about-text) * 1.9);
  }

  .about-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 1px solid var(--portfolio-hairline, rgb(255 255 255 / 8%));
    border-radius: 0.75rem;
    background: oklch(var(--b1));
    box-shadow: 0 1px 2px rgb(60 38 28 / 4%), 0 22px 44px -26px rgb(60 38 28 / 35%);
    opacity: var(--card, 1);
    transform: translateY(calc((1 - var(--card, 1)) * 14px));
  }

  /* Until the intro starts, the lines are hidden, so the note stays hidden with them. */
  .about-card:has([data-intro]:not(.is-revealed))::before {
    opacity: 0;
  }

  .hero-title {
    /* Sized so "I'm Guanhao" fits on one line inside the note at its narrowest. */
    font-size: calc(var(--about-text) * 2.4);
    line-height: 1.2;
  }

  .hero-subtitle {
    font-size: calc(var(--about-text) * 1.6);
    line-height: 1.35;
  }

  .hero-tagline {
    font-size: var(--about-text);
    line-height: 1.5;
  }

  /* A smaller lead line, so it fits the narrow column in one line; the typed field below stays large. */
  .subtitle-lead {
    display: block;
    font-size: 0.7em;
  }

  /* The typed field gets its own line, so typing and deleting never rewraps the lead or shifts the tagline. */
  .typewriter {
    display: block;
  }

  /* A thin caret after the typed field, in the field's colour (set by the script). */
  .hero-subtitle :global(.typewriter-caret) {
    display: inline-block;
    width: 0.09em;
    height: 1em;
    margin-left: 0.08em;
    vertical-align: -0.12em;
    background: oklch(var(--p));
    animation: caret-blink 0.9s steps(1) infinite;
  }

  @keyframes caret-blink {
    50% {
      visibility: hidden;
    }
  }
</style>
