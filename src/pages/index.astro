---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import LocalizedText from "../components/LocalizedText.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1"><LocalizedText en="Hey there 👋" zh="你好 👋" /></div>
    <div class="text-5xl font-bold"><LocalizedText en="I'm Guanhao Wang" zh="我是 Guanhao Wang" /></div>
    <div class="text-3xl py-3 font-bold"><LocalizedText en="A Computer Science Student & Game Developer" zh="是一名计算机科学专业学生与游戏开发者" /></div>
    <div class="py-2">
      <text class="text-lg">
        <LocalizedText
          en="I love video games and interactive experiences, and I enjoy designing them. Through programming and design, I hope to turn that passion into creations of my own."
          zh="我热爱电子游戏与交互体验，也享受设计它们的过程。我希望通过编程与设计，将这份热爱转化为自己的作品。"
        />
      </text>
    </div>
    <div class="mt-8">
      <a class="btn btn-outline btn-primary" href="/projects"><LocalizedText en="View my projects" zh="查看我的项目" /></a>
      <a href="/cv" class="btn btn-outline btn-primary ml-5">
        <LocalizedText en="View my resume" zh="查看我的简历" />
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2"><LocalizedText en="Ongoing Projects" zh="进行中项目" /></div>
  </div>

  <HorizontalCard
    title="Coal Echoes"
    titleZh="Coal Echoes 煤火回声"
    projectId="coal-echoes"
    coverPending
    desc="A narrative exploration game in development, set in an abandoned coal preparation plant. Use photography, a grandfather's diary, and a personal scrapbook to explore industrial and family memories."
    descZh="开发中的第一人称叙事探索游戏。通过摄影、爷爷的日记与个人手账，探索废弃洗煤厂中的工业记忆与家庭往事。"
    url="https://github.com/HowellWang04/Grad-App-Project-Coal"
    category="personal"
  />
  <div>
    <div class="text-3xl w-full font-bold mb-2 mt-10"><LocalizedText en="Completed Projects" zh="已完成项目" /></div>
  </div>
  <HorizontalCard
    title="Project Fireflies"
    titleZh="Project Fireflies 萤火虫"
    projectId="project-fireflies"
    coverPending
    coverComingSoon
    desc="An interactive light installation about ecological disturbance and recovery. Movement and bright light disrupt LED fireflies, while the Kuramoto model shapes their collective flashing rhythm. ESP32 sensing connects to Unity control and sound."
    descZh="围绕生态扰动与恢复设计的灯光交互装置。人体移动与强光影响 LED 萤火虫的行为，藏本模型驱动群体闪烁节奏，通过 ESP32 传感与 Unity 控制连接灯光和声音。"
    url="https://github.com/HowellWang04/Grad-App-Project-Fireflies"
    category="personal"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Project Sand"
    titleZh="Project Sand 治沙模拟器"
    projectId="project-sand"
    coverPending
    coverComingSoon
    desc="A desert restoration simulation. Plant trees, build factories, and mine for resources while balancing income against ecological damage. Watch wind, sand, heat haze, and the sky respond to your decisions."
    descZh="治沙模拟器。通过植树、建厂与采矿，在经济收益和生态损耗之间作出取舍，并观察风沙、热浪与天空随决策变化。"
    url="https://github.com/hwx676767/0714-WGH-sand"
    category="personal"
  />
  <a class="btn btn-sm btn-outline btn-primary rounded-full mt-4" href="/projects">
    <LocalizedText en="More projects" zh="更多项目" /><span aria-hidden="true">→</span>
  </a>
</BaseLayout>
