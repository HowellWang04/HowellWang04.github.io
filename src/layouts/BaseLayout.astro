---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SiteMenu from "../components/SiteMenu.astro";
import { ViewTransitions } from "astro:transitions";

import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../config";

// The page below the header slides on a page change; the header stays put.
const ease = "cubic-bezier(0.2, 1, 0.3, 1)";
const step = (name: string, duration: string) => ({ name, duration, easing: ease, fillMode: "both" });
const pageSlide = {
  forwards: { old: step("page-leave-up", "0.22s"), new: step("page-enter-up", "0.42s") },
  backwards: { old: step("page-leave-down", "0.22s"), new: step("page-enter-down", "0.42s") },
};

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  ogType,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="portfolio-light">
  <head>
    <script is:inline>
      const storedTheme = localStorage.getItem("astrofy-theme");
      // Light by default; dark only when the visitor has chosen it with the toggle.
      const initialTheme = storedTheme === "dark" ? "dark" : "portfolio-light";
      document.documentElement.dataset.theme = initialTheme;
      document.documentElement.style.colorScheme = initialTheme === "dark" ? "dark" : "light";
      document.documentElement.lang = sessionStorage.getItem("portfolio-language") === "zh-CN" ? "zh-CN" : "en";
      // Astro's router restores the saved scroll position on a full load, so a reload would open mid page and skip
      // the home intro. Opening or reloading a page starts at the top; back/forward and #section links keep their place.
      if (history.state && !location.hash && performance.getEntriesByType("navigation")[0]?.type !== "back_forward") {
        history.replaceState({ ...history.state, scrollX: 0, scrollY: 0 }, "");
      }
    </script>
    <BaseHead title={title} description={description} image={image} , ogType={ogType} />
    {TRANSITION_API && <ViewTransitions />}
    <noscript><style>:is([data-reveal], [data-intro], [data-reveal-children] > *):not(.is-revealed) { opacity: 1 !important; }</style></noscript>
  </head>
  <body>
    <div class="portfolio-canvas flex min-h-[100dvh] flex-col">
      <Header title={SITE_TITLE} />
      <div class="flex flex-1 flex-col" transition:name="page" transition:animate={pageSlide}>
        <!-- Full-width opening that sits outside the centred column (used by the home page). -->
        <slot name="hero" />
        <div class="flex-1 md:flex md:justify-center">
          <main class="p-6 pt-10 lg:max-w-[900px] max-w-[100vw]">
            <slot />
          </main>
        </div>
        <Footer />
      </div>
    </div>
    <!-- Persists across page changes (transition:persist on its root element). -->
    <SiteMenu />
  </body>
</html>

<script>
  import "../scripts/smooth-scroll";

  document.addEventListener("astro:before-preparation", (event) => {
    const loadPage = event.loader;
    event.loader = async () => {
      const destination = event.to;
      const requestURL = new URL(destination);
      // Keep cached HTML from an earlier deployment out of this navigation.
      requestURL.searchParams.set("_site_build", import.meta.env.PUBLIC_BUILD_ID);
      event.to = requestURL;
      try {
        await loadPage();
      } finally {
        event.to = destination;
      }
    };
  });

  // Reveal elements as the scroll reaches them: each rises 24px and fades in once it is a little way into the
  // window. [data-reveal] marks one element; [data-reveal-children] marks each child of a container, so a list or
  // a grid comes in piece by piece. Each batch plays in reading order: rows from top to bottom, and items within a
  // row from left to right. An element that scrolls fully out of the window hides again, so it plays again on the
  // way back. Intro parts ([data-intro]) play once.
  let enterObserver: IntersectionObserver | undefined;
  let exitObserver: IntersectionObserver | undefined;
  const revealTargets = "[data-reveal], [data-reveal-children] > *";

  const markRevealed = (element: HTMLElement) => {
    // Skip any CSS opacity transition (e.g. on .btn) so it can't fight the animation below.
    element.style.transition = "none";
    element.classList.add("is-revealed");
    getComputedStyle(element).opacity;
    element.style.transition = "";
  };

  const revealInOrder = (elements: HTMLElement[]) => {
    const animate = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ordered = elements
      .map((element) => ({ element, rect: element.getBoundingClientRect() }))
      .sort((a, b) => Math.round(a.rect.top / 24) - Math.round(b.rect.top / 24) || a.rect.left - b.rect.left);

    ordered.forEach(({ element }, index) => {
      markRevealed(element);
      if (element.hasAttribute("data-intro")) {
        enterObserver?.unobserve(element);
        exitObserver?.unobserve(element);
      }
      if (!animate) return;
      // translate, not transform, so hover effects that scale with transform still work while this plays.
      element.animate(
        [
          { opacity: 0, translate: "0 24px" },
          { opacity: 1, translate: "0 0" },
        ],
        {
          duration: 560,
          delay: Math.min(index, 8) * 70,
          easing: "cubic-bezier(0.2, 1, 0.3, 1)",
          fill: "backwards",
        },
      );
    });
  };

  const hide = (element: HTMLElement) => {
    element.getAnimations().forEach((animation) => animation.cancel());
    element.classList.remove("is-revealed");
  };

  const setupReveal = async () => {
    enterObserver?.disconnect();
    exitObserver?.disconnect();
    const main = document.querySelector<HTMLElement>("main");
    if (!main) return;

    // A page with an intro animation ([data-intro]) holds the rest of its reveal until the intro signals it is done.
    if (main.querySelector("[data-intro]") && !main.dataset.introDone) {
      const release = () => {
        main.dataset.introDone = "true";
        if (main.isConnected) setupReveal();
      };
      // Safety net in case the intro script never runs or breaks. A running intro gets far longer than it needs,
      // so this never cuts it short.
      let fallback = 0;
      const armFallback = (delay: number) => {
        fallback = window.setTimeout(() => {
          if (main.dataset.introStarted && delay < 15000) armFallback(15000);
          else release();
        }, delay);
      };
      armFallback(3000);
      document.addEventListener("portfolio:intro-done", () => { clearTimeout(fallback); release(); }, { once: true });
      return;
    }
    // Intro parts that didn't animate themselves (intro skipped or failed) join the normal reveal.
    main.querySelectorAll("[data-intro]:not(.is-revealed)").forEach((element) => element.setAttribute("data-reveal", ""));

    const pending = [...main.querySelectorAll<HTMLElement>(revealTargets)].filter(
      (element) => !(element.hasAttribute("data-intro") && element.classList.contains("is-revealed")),
    );
    if (!pending.length) return;

    // In once it is 6% of the window past the edge; out once it has fully left.
    enterObserver = new IntersectionObserver((entries) => {
      const arriving = entries
        .filter((entry) => entry.isIntersecting && !entry.target.classList.contains("is-revealed"))
        .map((entry) => entry.target as HTMLElement);
      if (arriving.length) revealInOrder(arriving);
    }, { rootMargin: "-6% 0px -6% 0px" });
    exitObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting && entry.target.classList.contains("is-revealed")) hide(entry.target as HTMLElement);
      });
    });
    pending.forEach((element) => {
      enterObserver!.observe(element);
      exitObserver!.observe(element);
    });
  };

  // Keyboard users tabbing ahead of the scroll still see what they focus.
  document.addEventListener("focusin", (event) => {
    const target = event.target as HTMLElement;
    const element = [...document.querySelectorAll<HTMLElement>(revealTargets)].find(
      (candidate) => !candidate.classList.contains("is-revealed") && candidate.contains(target),
    );
    if (element) revealInOrder([element]);
  });

  setupReveal();
  document.addEventListener("astro:page-load", setupReveal);
  document.addEventListener("astro:before-swap", () => {
    enterObserver?.disconnect();
    exitObserver?.disconnect();
  });
</script>
