<div class="language-switch" role="group" aria-label="Language / 语言" data-language-switch>
  <button type="button" data-language-toggle="en" lang="en" aria-label="English" aria-pressed="true">EN</button>
  <button type="button" data-language-toggle="zh-CN" lang="zh-CN" aria-label="中文" aria-pressed="false">中</button>
</div>

<script>
  const preferredLanguage = () => localStorage.getItem("portfolio-language") === "zh-CN" ? "zh-CN" : "en";
  let transitionId = 0;
  let textAnimations: Animation[] = [];

  const updateControls = (page: Document, language: string) => {
    page.querySelectorAll<HTMLElement>("[data-language-switch]").forEach((control) => {
      control.dataset.selectedLanguage = language;
    });
    page.querySelectorAll<HTMLButtonElement>("[data-language-toggle]").forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.languageToggle === language));
    });
  };

  const applyLanguage = (page: Document, language: string) => {
    page.documentElement.lang = language;
    page.querySelectorAll<HTMLElement>("[data-en][data-zh]").forEach((element) => {
      element.textContent = language === "zh-CN" ? element.dataset.zh! : element.dataset.en!;
    });
    updateControls(page, language);
  };

  const cancelTextAnimations = () => {
    transitionId++;
    textAnimations.forEach((animation) => animation.cancel());
    textAnimations = [];
  };

  const changeLanguage = async (language: string) => {
    if (language === preferredLanguage()) return;
    cancelTextAnimations();
    const currentTransition = transitionId;
    localStorage.setItem("portfolio-language", language);
    updateControls(document, language);

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const visibleText = Array.from(document.querySelectorAll<HTMLElement>("[data-en][data-zh]")).filter((element) => {
      const bounds = element.getBoundingClientRect();
      return element.dataset.en !== element.dataset.zh && bounds.width > 0 && bounds.height > 0
        && bounds.bottom > 0 && bounds.top < window.innerHeight;
    });

    if (!reducedMotion) {
      textAnimations = visibleText.map((element) => element.animate(
        [{ opacity: 1, filter: "blur(0px)" }, { opacity: 0, filter: "blur(2px)" }],
        { duration: 80, easing: "ease-in", fill: "forwards" },
      ));
      await Promise.all(textAnimations.map((animation) => animation.finished.catch(() => {})));
      if (currentTransition !== transitionId) return;
    }

    const anchor = window.scrollY > 0
      ? visibleText.find((element) => element.closest("main") && element.getBoundingClientRect().top >= 80)
      : undefined;
    const anchorTop = anchor?.getBoundingClientRect().top;
    applyLanguage(document, language);
    document.dispatchEvent(new Event("portfolio:language-change"));
    textAnimations.forEach((animation) => animation.cancel());
    textAnimations = [];

    if (anchor && anchorTop !== undefined) {
      window.scrollBy(0, anchor.getBoundingClientRect().top - anchorTop);
    }

    if (!reducedMotion) {
      textAnimations = visibleText.map((element) => element.animate(
        [
          { opacity: 0, filter: "blur(3px)", transform: "translateY(4px)" },
          { opacity: 1, filter: "blur(0px)", transform: "translateY(0)" },
        ],
        { duration: 180, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
      ));
      await Promise.all(textAnimations.map((animation) => animation.finished.catch(() => {})));
      if (currentTransition === transitionId) textAnimations = [];
    }
  };

  const setupLanguage = () => {
    applyLanguage(document, preferredLanguage());
    document.querySelectorAll<HTMLButtonElement>("[data-language-toggle]").forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = "true";
      button.addEventListener("click", () => {
        void changeLanguage(button.dataset.languageToggle!);
      });
    });
  };

  setupLanguage();
  document.addEventListener("astro:page-load", setupLanguage);
  document.addEventListener("astro:before-swap", (event) => {
    cancelTextAnimations();
    applyLanguage(event.newDocument, preferredLanguage());
  });
</script>

<style>
  .language-switch {
    position: relative;
    display: inline-grid;
    grid-template-columns: repeat(2, 2.25rem);
    padding: 3px;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 999px;
    isolation: isolate;
  }

  .language-switch::before {
    content: "";
    position: absolute;
    inset: 3px auto 3px 3px;
    width: 2.25rem;
    border-radius: 999px;
    background: #8B4935;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
    z-index: -1;
  }

  :global(html[data-theme="dark"]) .language-switch::before { background: #D5966F; }
  .language-switch[data-selected-language="zh-CN"]::before { transform: translateX(100%); }

  button {
    height: 1.75rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    opacity: 0.65;
    transition: color 180ms ease, opacity 180ms ease;
  }

  button:hover { opacity: 1; }
  button[aria-pressed="true"] { color: #FFFFFF; opacity: 1; }
  :global(html[data-theme="dark"]) button[aria-pressed="true"] { color: #211B18; }
  button:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

  @media (prefers-reduced-motion: reduce) {
    .language-switch::before, button { transition: none; }
  }
</style>
