---
const { class: className = "" } = Astro.props;
---

<button
  type="button"
  class:list={[
    "theme-toggle btn btn-circle btn-ghost shadow-md transition duration-300 ease-in-out hover:scale-110 hover:bg-base-300",
    className,
  ]}
  data-theme-toggle
  aria-label="Switch to dark theme"
  aria-pressed="false"
  title="Switch theme"
>
  <svg
    class="theme-icon theme-icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.8"
    stroke="currentColor"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21.75 15.75A9 9 0 0 1 8.25 2.25a9 9 0 1 0 13.5 13.5Z"
    ></path>
  </svg>
  <svg
    class="theme-icon theme-icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.8"
    stroke="currentColor"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v1.5m0 15V21m9-9h-1.5M4.5 12H3m15.364-6.364-1.061 1.061M6.697 17.303l-1.061 1.061m12.728 0-1.061-1.061M6.697 6.697 5.636 5.636M16.5 12a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z"
    ></path>
  </svg>
</button>

<script>
  const storageKey = "astrofy-theme";

  const getPreferredTheme = (): "portfolio-light" | "dark" => {
    const storedTheme = localStorage.getItem(storageKey);
    if (storedTheme) return storedTheme === "dark" ? "dark" : "portfolio-light";
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "portfolio-light";
  };

  const setTheme = (root: HTMLElement, theme: "portfolio-light" | "dark") => {
    root.dataset.theme = theme;
    root.style.colorScheme = theme === "dark" ? "dark" : "light";
  };

  const applyTheme = (theme: "portfolio-light" | "dark") => {
    setTheme(document.documentElement, theme);

    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
      const isDark = theme === "dark";
      button.setAttribute("aria-pressed", String(isDark));
      const chinese = document.documentElement.lang === "zh-CN";
      const label = chinese
        ? (isDark ? "切换到亮色模式" : "切换到暗色模式")
        : (isDark ? "Switch to light theme" : "Switch to dark theme");
      button.setAttribute("aria-label", label);
      button.title = label;
    });
  };

  const setupThemeToggles = () => {
    const theme = document.documentElement.dataset.theme === "dark" ? "dark" : "portfolio-light";
    applyTheme(theme);

    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
      if (button.dataset.themeToggleBound) return;

      button.dataset.themeToggleBound = "true";
      button.addEventListener("click", () => {
        const nextTheme = document.documentElement.dataset.theme === "dark" ? "portfolio-light" : "dark";
        localStorage.setItem(storageKey, nextTheme);
        applyTheme(nextTheme);
      });
    });
  };

  setupThemeToggles();
  document.addEventListener("astro:before-swap", (event) => {
    setTheme(event.newDocument.documentElement, getPreferredTheme());
  });
  document.addEventListener("astro:page-load", setupThemeToggles);
  document.addEventListener("portfolio:language-change", setupThemeToggles);
</script>

<style>
  .theme-icon {
    width: 1.4rem;
    height: 1.4rem;
    transition: opacity 200ms ease, transform 300ms ease;
  }

  .theme-icon-sun {
    display: none;
  }

  :global(html[data-theme="dark"]) .theme-icon-moon {
    display: none;
  }

  :global(html[data-theme="dark"]) .theme-icon-sun {
    display: block;
  }

  .theme-toggle:active .theme-icon {
    transform: rotate(18deg) scale(0.9);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-icon {
      transition: none;
    }
  }
</style>
