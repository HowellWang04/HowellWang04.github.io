---
const { class: className = "" } = Astro.props;
---

<button
  type="button"
  class:list={[
    "theme-toggle",
    className,
  ]}
  data-theme-toggle
  aria-label="Switch to dark theme"
  aria-pressed="false"
  title="Switch theme"
>
  <!-- One icon that morphs: the bite slides off the moon, the disc shrinks and the rays spin out into a sun -->
  <svg class="theme-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
    <mask id="theme-moon-mask">
      <rect width="24" height="24" fill="white"></rect>
      <circle class="moon-bite" cx="18" cy="6" r="7" fill="black"></circle>
    </mask>
    <circle class="sun-core" cx="12" cy="12" r="9" fill="currentColor" mask="url(#theme-moon-mask)"></circle>
    <g class="sun-rays" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="12" y1="4" x2="12" y2="1.5"></line>
      <line x1="17.66" y1="6.34" x2="19.43" y2="4.57"></line>
      <line x1="20" y1="12" x2="22.5" y2="12"></line>
      <line x1="17.66" y1="17.66" x2="19.43" y2="19.43"></line>
      <line x1="12" y1="20" x2="12" y2="22.5"></line>
      <line x1="6.34" y1="17.66" x2="4.57" y2="19.43"></line>
      <line x1="4" y1="12" x2="1.5" y2="12"></line>
      <line x1="6.34" y1="6.34" x2="4.57" y2="4.57"></line>
    </g>
  </svg>
</button>

<script>
  const storageKey = "astrofy-theme";

  const getPreferredTheme = (): "portfolio-light" | "dark" => {
    const storedTheme = localStorage.getItem(storageKey);
    if (storedTheme) return storedTheme === "dark" ? "dark" : "portfolio-light";
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "portfolio-light";
  };

  const setTheme = (root: HTMLElement, theme: "portfolio-light" | "dark") => {
    root.dataset.theme = theme;
    root.style.colorScheme = theme === "dark" ? "dark" : "light";
  };

  const applyTheme = (theme: "portfolio-light" | "dark") => {
    setTheme(document.documentElement, theme);

    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
      const isDark = theme === "dark";
      button.setAttribute("aria-pressed", String(isDark));
      const chinese = document.documentElement.lang === "zh-CN";
      const label = chinese
        ? (isDark ? "切换到亮色模式" : "切换到暗色模式")
        : (isDark ? "Switch to light theme" : "Switch to dark theme");
      button.setAttribute("aria-label", label);
      button.title = label;
    });
  };

  const setupThemeToggles = () => {
    const theme = document.documentElement.dataset.theme === "dark" ? "dark" : "portfolio-light";
    applyTheme(theme);

    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
      if (button.dataset.themeToggleBound) return;

      button.dataset.themeToggleBound = "true";
      button.addEventListener("click", () => {
        const nextTheme = document.documentElement.dataset.theme === "dark" ? "portfolio-light" : "dark";
        localStorage.setItem(storageKey, nextTheme);
        applyTheme(nextTheme);
      });
    });
  };

  setupThemeToggles();
  document.addEventListener("astro:before-swap", (event) => {
    setTheme(event.newDocument.documentElement, getPreferredTheme());
  });
  document.addEventListener("astro:page-load", setupThemeToggles);
  document.addEventListener("portfolio:language-change", setupThemeToggles);
</script>

<style>
  /* Matches the language switch: hairline outline, no shadow, same height */
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    box-sizing: content-box;
    width: calc(1.75rem + 6px);
    height: calc(1.75rem + 6px);
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 999px;
    opacity: 0.8;
    /* Release springs back with a slight overshoot */
    transition: opacity 180ms ease, background-color 180ms ease, transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .theme-toggle:hover {
    opacity: 1;
    background-color: color-mix(in srgb, currentColor 6%, transparent);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  /* Press sinks in quickly and eases to a stop */
  .theme-toggle:active {
    transform: scale(0.9);
    transition-duration: 180ms, 180ms, 140ms;
    transition-timing-function: ease, ease, cubic-bezier(0.22, 1, 0.36, 1);
  }

  .theme-icon {
    --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    width: 1.1rem;
    height: 1.1rem;
    overflow: visible;
    transition: transform 600ms var(--spring);
  }

  .sun-core,
  .sun-rays {
    transform-box: view-box;
    transform-origin: 12px 12px;
  }

  /* Moon (light theme) */
  .sun-core {
    transition: transform 500ms var(--spring);
  }

  .moon-bite {
    transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sun-rays {
    opacity: 0;
    transform: rotate(-120deg) scale(0.3);
    transition: opacity 200ms ease, transform 400ms ease-in;
  }

  .sun-rays line {
    opacity: 0;
    transition: opacity 150ms ease;
  }

  /* Sun (dark theme) */
  :global(html[data-theme="dark"]) .theme-icon {
    transform: rotate(180deg);
  }

  :global(html[data-theme="dark"]) .sun-core {
    transform: scale(0.55);
  }

  :global(html[data-theme="dark"]) .moon-bite {
    transform: translate(9px, -9px);
  }

  :global(html[data-theme="dark"]) .sun-rays {
    opacity: 1;
    transform: none;
    transition: opacity 250ms ease 120ms, transform 700ms var(--spring) 120ms;
  }

  /* Rays light up one after another around the disc (transitions only run on an actual toggle) */
  :global(html[data-theme="dark"]) .sun-rays line {
    opacity: 1;
    transition: opacity 220ms ease calc(120ms + var(--ray) * 45ms);
  }

  .sun-rays line:nth-child(2) { --ray: 1; }
  .sun-rays line:nth-child(3) { --ray: 2; }
  .sun-rays line:nth-child(4) { --ray: 3; }
  .sun-rays line:nth-child(5) { --ray: 4; }
  .sun-rays line:nth-child(6) { --ray: 5; }
  .sun-rays line:nth-child(7) { --ray: 6; }
  .sun-rays line:nth-child(8) { --ray: 7; }
  .sun-rays line:nth-child(1) { --ray: 0; }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-icon,
    .sun-core,
    .moon-bite,
    .sun-rays,
    .sun-rays line,
    :global(html[data-theme="dark"]) .sun-rays,
    :global(html[data-theme="dark"]) .sun-rays line {
      transition: none;
    }
  }
</style>
