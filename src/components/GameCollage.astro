---
import LocalizedText from "./LocalizedText.astro";

// A scrapbook wall: each game is a taped-down photo with its title and a few words about it, laid out in straight rows.
// Steam games use Steam's 600x900 library capsule art; other covers are cropped to the same 2:3 frame.
const steamCover = (appId: number) => `https://cdn.cloudflare.steamstatic.com/steam/apps/${appId}/library_600x900.jpg`;

type Text = { en: string; zh: string };
type Photo = {
  title: string;
  titleZh: string;
  cover: string;
  desc: Text;
};

const photos: Photo[] = [
  {
    title: "Resident Evil 4",
    titleZh: "生化危机 4",
    cover: steamCover(2050650),
    desc: {
      en: "Completely linear, yet I always knew what to do next. The action feels great, and the tension rises and falls so well I could never put it down.",
      zh: "非常线性，但我总是清楚下一步该做什么。动作手感极好，紧张与放松交替的节奏让人一直停不下来。",
    },
  },
  {
    title: "Portal 2",
    titleZh: "传送门 2",
    cover: steamCover(620),
    desc: {
      en: "A brilliant portal mechanic inside a world that tells its own story. The Aperture labs say more than any cutscene could.",
      zh: "天才般的传送门玩法，加上极强的环境叙事。光圈科技实验室的设定与废墟本身就在讲故事。",
    },
  },
  {
    title: "Death Stranding",
    titleZh: "死亡搁浅",
    cover: steamCover(1850570),
    desc: {
      en: "A bold, strange setting that blends game and film seamlessly. Even walking and delivering grow straight out of its world.",
      zh: "设定大胆而独特，游戏化与电影化结合得非常好。就连行走和送货这些玩法，也都源自它的世界观。",
    },
  },
  {
    title: "The Walking Dead",
    titleZh: "行尸走肉",
    cover: steamCover(1449690),
    desc: {
      en: "First I was Lee, protecting Clementine. Later I became Clementine and watched her grow up. Every character pulled me in.",
      zh: "第一季我是李，守护着克莱曼婷；后来我成了克莱曼婷，看着她一点点长大。每个角色都让人深陷其中。",
    },
  },
  {
    title: "The Last of Us Part I",
    titleZh: "最后生还者 第一部",
    cover: steamCover(1888930),
    desc: {
      en: "Another linear journey I still remember vividly. The bond between Joel and Ellie carries the whole story.",
      zh: "同样是线性的旅程，至今仍记忆犹新。乔尔和艾莉之间的羁绊撑起了整个故事。",
    },
  },
  {
    title: "Breath of the Wild",
    titleZh: "旷野之息",
    cover: "https://upload.wikimedia.org/wikipedia/en/c/c6/The_Legend_of_Zelda_Breath_of_the_Wild.jpg",
    desc: {
      en: "A fantasy world that feels real, because it is built on rules from our own. Everything in it, its people included, feels connected.",
      zh: "这是一个幻想世界，却真实可信，因为它建立在真实世界的规律之上。里面的一切，包括角色，都紧密相连。",
    },
  },
];

---

<ul class="collage" data-collage>
  {photos.map((photo, index) => (
    <li
      style={`--tape: ${index % 2 ? -4 : 3}deg`}
    >
      <div class="card paper taped">
        <img src={photo.cover} alt={photo.title} width="600" height="900" loading="lazy" decoding="async" />
        <span class="caption">
          <span class="caption-title"><LocalizedText en={photo.title} zh={photo.titleZh} /></span>
          <span class="caption-desc"><LocalizedText {...photo.desc} /></span>
        </span>
      </div>
    </li>
  ))}
</ul>
<noscript><style>[data-collage] > li { --land: 1 !important; }</style></noscript>

<script>
  // Scroll-linked drop: each photo falls onto the page from above and its tape sticks
  // down as it lands. Scrolling back up lifts it off again. Nothing drops until the home intro is done.
  // The middle photo of a row drops straight down; the ones beside it come in at a slant from the outside,
  // mirrored left and right, and a whole row lands together.
  let teardownDrop: (() => void) | undefined;

  const setupDrop = () => {
    teardownDrop?.();
    teardownDrop = undefined;
    const main = document.querySelector<HTMLElement>("main");
    const collage = document.querySelector<HTMLElement>("[data-collage]");
    if (!main || !collage) return;
    const items = [...collage.children] as HTMLElement[];
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      items.forEach((item) => item.style.setProperty("--land", "1"));
      return;
    }

    const clamp = (value: number) => Math.min(1, Math.max(0, value));

    // Which side of the collage each photo is on (-1 left, 0 middle, 1 right) and which row it is in. Offsets
    // ignore transforms, so the drop itself doesn't change the answer.
    const layout = () => {
      const middle = collage.clientWidth / 2;
      const rows = [...new Set(items.map((item) => item.offsetTop))].sort((a, b) => a - b);
      items.forEach((item) => {
        const offset = item.offsetLeft + item.offsetWidth / 2 - middle;
        const side = Math.abs(offset) < item.offsetWidth / 4 ? 0 : Math.sign(offset);
        item.style.setProperty("--from-x", `${side * 90}px`);
        item.style.setProperty("--deal-delay", `${rows.indexOf(item.offsetTop) * 140}ms`);
      });
    };
    let frame = 0;
    let dealt = false;
    const update = () => {
      frame = 0;
      const ready = Boolean(main.dataset.introDone);
      // The first drop after the intro plays photo by photo; after that the photos follow the scroll directly.
      if (ready && !dealt) {
        dealt = true;
        collage.classList.add("is-dealing");
        setTimeout(() => collage.classList.remove("is-dealing"), 1400);
      }
      items.forEach((item) => {
        // Measured from the row's resting place, so photos in one row always land together.
        const top = collage.getBoundingClientRect().top + item.offsetTop;
        const land = ready ? clamp((window.innerHeight * 0.98 - top) / (window.innerHeight * 0.4)) : 0;
        item.style.setProperty("--land", land.toFixed(3));
      });
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    const resize = () => {
      layout();
      schedule();
    };
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", resize);
    document.addEventListener("portfolio:intro-done", schedule);
    layout();
    update();

    teardownDrop = () => {
      cancelAnimationFrame(frame);
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("resize", resize);
      document.removeEventListener("portfolio:intro-done", schedule);
    };
  };

  setupDrop();
  document.addEventListener("astro:page-load", setupDrop);
</script>

<style>
  .collage {
    /* The photos' offsets are measured from here. */
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.75rem 1rem;
    max-width: 40rem;
    margin-top: 2rem;
    padding: 1rem 0.5rem 2rem;
  }

  /* 0 = still in the air, 1 = taped down. Registered so the first deal can ease each photo down. */
  @property --land {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  .collage > li {
    --lift: calc(1 - var(--land));
    position: relative;
    opacity: clamp(0, calc(var(--land) * 2.5), 1);
    transform: translate(calc(var(--lift) * var(--from-x, 0px)), calc(var(--lift) * -64px)) scale(calc(1 + var(--lift) * 0.2));
    /* Each photo gets its own GPU layer, so following the scroll only moves the layer instead of repainting the photo. */
    will-change: transform, opacity;
  }

  /* The transform gives each photo its own stacking layer, so lift the hovered one above its neighbours here. */
  .collage > li:hover {
    z-index: 2;
  }

  /* Only the first drop eases photo by photo. After that the photos follow the (already smoothed) scroll directly:
     a transition on a custom property runs on the main thread and restarted on every scroll frame. */
  .collage.is-dealing > li {
    transition: --land 650ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--deal-delay);
  }

  .card {
    position: relative;
    display: block;
    padding: 0.5rem 0.5rem 0;
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* The shadow spreads while the photo is still in the air. A fixed wide shadow fades in on its own layer, instead of
     the card's shadow growing, so a falling photo never has to be repainted. */
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    box-shadow: 0 38px 48px -12px rgb(40 28 20 / 45%);
    opacity: var(--lift, 0);
    will-change: opacity;
    pointer-events: none;
  }

  /* A strip of semi-transparent tape (its look is in global.css) holding each photo to the page. Once the photo has
     landed, the tape is pressed on in one go: it comes down slightly larger and askew, then settles flat onto the
     paper. z-index: the photo's filter gives it its own layer, which would otherwise be drawn over the tape. */
  .card::before {
    --stick: clamp(0, calc((var(--land) - 0.82) * 5.5), 1);
    top: -0.65rem;
    left: 50%;
    z-index: 1;
    width: 42%;
    opacity: var(--stick);
    transform: translateX(-50%) rotate(calc(var(--tape) + (1 - var(--stick)) * 9deg)) scale(calc(1.35 - var(--stick) * 0.35));
  }

  /* Hover only on devices with a mouse, so a tap on a phone doesn't leave a card stuck raised. */
  @media (hover: hover) {
    .card:hover {
      transform: translateY(-6px) scale(1.06);
    }
  }

  .card img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    filter: sepia(0.15) saturate(0.9);
    /* A hairline where the print meets the paper. */
    outline: 1px solid rgb(0 0 0 / 8%);
    outline-offset: -1px;
  }

  .caption {
    display: grid;
    gap: 0.3rem;
    padding: 0.6rem 0.2rem 0.75rem;
  }

  .caption-title {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .caption-desc {
    font-family: var(--font-body);
    font-size: 0.8rem;
    line-height: 1.2;
    opacity: 0.85;
  }

  @media (max-width: 600px) {
    .collage {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .caption-desc {
      font-size: 0.72rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .collage > li {
      transition: none;
    }
  }
</style>
