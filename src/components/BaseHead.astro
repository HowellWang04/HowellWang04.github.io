---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { GOATCOUNTER_CODE } from '../config';

export interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
}

const { title, description, image = '/social_img.webp', ogType = 'website' } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Fonts: Courier Prime for headings, Source Serif 4 for body text, LXGW WenKai GB for Chinese,
     Caveat + Long Cang for handwritten notes -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&family=Caveat:wght@400..700&family=Long+Cang&display=swap" rel="stylesheet" />
<!-- LXGW WenKai GB comes pre-sliced, so browsers only fetch the chunks for characters on the page -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-gb-web@1.522.0/lxgwwenkaigb-regular/result.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-gb-web@1.522.0/lxgwwenkaigb-medium/result.css" rel="stylesheet" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- Visitor counting (GoatCounter: no cookies, localhost is ignored). Page changes don't reload the page, so the
     script below counts each page itself instead of letting count.js count only the first one. -->
{GOATCOUNTER_CODE && (
	<script is:inline async data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`} data-goatcounter-settings='{"no_onload": true}' src="https://gc.zgo.at/count.js"></script>
)}

<script>
	// count.js loads async, so the first page may arrive before it does; wait a few seconds for it.
	const countPage = () => {
		let tries = 0;
		const timer = window.setInterval(() => {
			const goatcounter = (window as any).goatcounter;
			if (goatcounter?.count) goatcounter.count({ path: location.pathname });
			if (goatcounter?.count || ++tries > 50) window.clearInterval(timer);
		}, 100);
	};

	if (document.querySelector("[data-goatcounter]")) document.addEventListener("astro:page-load", countPage);
</script>
