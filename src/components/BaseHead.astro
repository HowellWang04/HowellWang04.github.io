---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { GOATCOUNTER_CODE } from '../config';

export interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
}

const { title, description, image = '/social_img.webp', ogType = 'website' } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Fonts: Courier Prime for headings, Source Serif 4 for body text, Alimama FangYuanTi for Chinese (in global.css),
     Caveat + Long Cang for handwritten notes. All of them are served from this site, since Google Fonts and jsDelivr
     are blocked in mainland China. -->
<link href="/fonts/fonts.css" rel="stylesheet" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- Visitor counting (GoatCounter: no cookies, localhost is ignored). Page changes don't reload the page, so the
     script below counts each page itself instead of letting count.js count only the first one. -->
{GOATCOUNTER_CODE && (
	<script is:inline async data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`} data-goatcounter-settings='{"no_onload": true}' src="https://gc.zgo.at/count.js"></script>
)}

<script>
	// GoatCounter counts a visitor once per page, so someone who looks at four pages counts four times. The visitor
	// map counts people instead: each browser also sends a single "visit" event, the first time it ever comes by.
	const visitedKey = "guanhao-visited";
	const countVisit = (goatcounter: any) => {
		try {
			// filter() says why a hit wouldn't be sent (localhost, or switched off with #toggle-goatcounter).
			if (localStorage.getItem(visitedKey) || goatcounter.filter?.()) return;
			goatcounter.count({ path: "visit", title: "First visit", event: true });
			// When this browser first came by, so the visitor map can show it before the next build counts it.
			localStorage.setItem(visitedKey, String(Date.now()));
			window.dispatchEvent(new Event("guanhao:first-visit"));
		} catch {
			// Storage blocked: skip the visit rather than count this browser again on every page.
		}
	};

	// count.js loads async, so the first page may arrive before it does; wait a few seconds for it.
	const countPage = () => {
		let tries = 0;
		const timer = window.setInterval(() => {
			const goatcounter = (window as any).goatcounter;
			if (goatcounter?.count) {
				goatcounter.count({ path: location.pathname });
				countVisit(goatcounter);
			}
			if (goatcounter?.count || ++tries > 50) window.clearInterval(timer);
		}, 100);
	};

	if (document.querySelector("[data-goatcounter]")) document.addEventListener("astro:page-load", countPage);
</script>
