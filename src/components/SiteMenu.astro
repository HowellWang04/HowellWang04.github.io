---
import LocalizedText from "./LocalizedText.astro";
import { pages } from "../data/navigation";
---

<!-- Once the header has scrolled away (or on small screens), a round button floats in at the top right
     and opens a side menu with the page links. -->
<div class="site-menu" data-site-menu transition:persist="site-menu">
  <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-menu-panel" aria-label="Open menu" data-menu-toggle>
    <span class="menu-toggle-lines" aria-hidden="true"><span></span><span></span></span>
  </button>
  <div class="menu-backdrop" data-menu-backdrop></div>
  <nav id="site-menu-panel" class="menu-panel" aria-label="Menu" data-menu-panel>
    <p class="menu-heading"><LocalizedText en="Navigation" zh="导航" /></p>
    <ul class="menu-links">
      {pages.map((page) => (
        <li data-menu-item>
          <a class="menu-link" href={page.href} data-menu-link>
            <span class="menu-dot" aria-hidden="true"></span>
            <LocalizedText en={page.en} zh={page.zh} />
          </a>
        </li>
      ))}
    </ul>
    <div class="menu-socials" data-menu-item>
      <a href="mailto:gwang284@wisc.edu">Email</a>
      <a href="https://github.com/HowellWang04" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </nav>
</div>

<script>
  import { gsap, lenis } from "../scripts/smooth-scroll";

  const setupSiteMenu = () => {
    const root = document.querySelector<HTMLElement>("[data-site-menu]");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "true";

    const toggle = root.querySelector<HTMLButtonElement>("[data-menu-toggle]")!;
    const panel = root.querySelector<HTMLElement>("[data-menu-panel]")!;
    const backdrop = root.querySelector<HTMLElement>("[data-menu-backdrop]")!;
    const items = [...root.querySelectorAll<HTMLElement>("[data-menu-item]")];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let open = false;

    // The button floats in once the header is out of view; it is always there on small screens.
    const updateVisibility = () => {
      const show = open || window.scrollY > 96 || window.innerWidth < 640;
      root.classList.toggle("is-visible", show);
    };

    // Mark the current page in the menu.
    const markCurrent = () => {
      const current = location.pathname.replace(/\/$/, "") || "/";
      root.querySelectorAll<HTMLAnchorElement>("[data-menu-link]").forEach((link) => {
        if (link.getAttribute("href") === current) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
    };

    const setOpen = (next: boolean) => {
      if (open === next) return;
      open = next;
      root.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      updateVisibility();
      if (open) lenis?.stop();
      else lenis?.start();

      const duration = reducedMotion ? 0 : 1;
      gsap.killTweensOf([panel, backdrop, items]);
      if (open) {
        gsap.to(backdrop, { autoAlpha: 1, duration: 0.4 * duration });
        gsap.to(panel, { xPercent: 0, duration: 0.7 * duration, ease: "power4.out" });
        gsap.fromTo(items, { x: 60, autoAlpha: 0 }, { x: 0, autoAlpha: 1, duration: 0.7 * duration, ease: "power3.out", stagger: 0.06 * duration, delay: 0.1 * duration });
      } else {
        gsap.to(backdrop, { autoAlpha: 0, duration: 0.35 * duration });
        gsap.to(panel, { xPercent: 100, duration: 0.55 * duration, ease: "power3.inOut" });
      }
    };

    // x: 0 drops the stylesheet's translateX(100%), which GSAP would otherwise read as a fixed pixel offset.
    gsap.set(panel, { x: 0, xPercent: 100 });
    gsap.set(backdrop, { autoAlpha: 0 });
    toggle.addEventListener("click", () => setOpen(!open));
    backdrop.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
    // Choosing a page closes the menu as the page transition starts.
    root.querySelectorAll("[data-menu-link]").forEach((link) => link.addEventListener("click", () => setOpen(false)));

    window.addEventListener("scroll", updateVisibility, { passive: true });
    window.addEventListener("resize", updateVisibility);
    document.addEventListener("astro:page-load", () => {
      markCurrent();
      updateVisibility();
    });
    markCurrent();
    updateVisibility();
  };

  setupSiteMenu();
  document.addEventListener("astro:page-load", setupSiteMenu);
</script>

<style>
  .menu-toggle {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 61;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    background: oklch(var(--bc));
    color: oklch(var(--b1));
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 45%);
    transform: scale(0);
    transition: transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .site-menu.is-visible .menu-toggle {
    transform: scale(1);
  }

  .menu-toggle:active {
    transform: scale(0.92);
  }

  /* Two lines that turn into a cross while the menu is open. */
  .menu-toggle-lines {
    position: relative;
    width: 1.25rem;
    height: 0.6rem;
  }

  .menu-toggle-lines span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1), top 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menu-toggle-lines span:first-child { top: 0; }
  .menu-toggle-lines span:last-child { top: calc(100% - 2px); }

  .site-menu.is-open .menu-toggle-lines span { top: calc(50% - 1px); }
  .site-menu.is-open .menu-toggle-lines span:first-child { transform: rotate(45deg); }
  .site-menu.is-open .menu-toggle-lines span:last-child { transform: rotate(-45deg); }

  .menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: 59;
    background: rgb(10 12 18 / 45%);
    visibility: hidden;
  }

  .menu-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    width: min(28rem, 100vw);
    padding: 6.5rem 3rem 3rem;
    background: oklch(var(--bc));
    color: oklch(var(--b1));
    transform: translateX(100%);
  }

  .menu-heading {
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .menu-links {
    display: grid;
    gap: 0.5rem;
  }

  .menu-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .menu-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 9999px;
    background: currentColor;
    transform: scale(0);
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menu-link:hover .menu-dot,
  .menu-link[aria-current="page"] .menu-dot {
    transform: scale(1);
  }

  .menu-socials {
    display: flex;
    gap: 1.5rem;
    margin-top: auto;
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .menu-socials a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle,
    .menu-toggle-lines span,
    .menu-dot {
      transition: none;
    }
  }
</style>
