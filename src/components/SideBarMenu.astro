---
import LocalizedText from "./LocalizedText.astro";
const { sideBarActiveItemID } = Astro.props;
const chineseLabels = { home: "首页", projects: "项目", cv: "简历" };
const menuItems = [
    { id: "home", label: "Home", href: "/" },
    { id: "projects", label: "Projects", href: "/projects" },
    { id: "cv", label: "CV", href: "/cv" },
];
---

<ul class="menu grow shrink menu-md overflow-y-auto">
    {
        menuItems.map((item) => {
            const isActive = item.id === sideBarActiveItemID;

            return (
                <li>
                    <a
                        class:list={[
                            "sidebar-link group my-0.5 py-3 text-base transform-gpu transition duration-300 ease-in-out hover:scale-[1.03] hover:bg-base-300",
                            isActive && "scale-[1.03] bg-base-300 font-semibold text-primary shadow-sm",
                        ]}
                        id={item.id}
                        href={item.href}
                        aria-current={isActive ? "page" : undefined}
                        transition:name={`sidebar-item-${item.id}`}
                        transition:animate="fade"
                    >
                        <span
                            class:list={[
                                "sidebar-dot h-2 w-2 rounded-full bg-base-content/30 transition duration-300 group-hover:scale-125 group-hover:bg-primary",
                                isActive && "scale-125 bg-primary",
                            ]}
                            aria-hidden="true"
                        ></span>
                        <span class="flex-1">
                            <LocalizedText en={item.label} zh={chineseLabels[item.id]} />
                        </span>
                    </a>
                </li>
            );
        })
    }
    <li>
        <a
            class="sidebar-link py-3 text-base"
            href="mailto:howellwang7679@gmail.com"><span class="flex-1" transition:name="sidebar-label-contact" transition:animate="none"><LocalizedText en="Contact" zh="联系我" /></span></a
        >
    </li>
</ul>

<style>
    .sidebar-link {
        will-change: transform;
        backface-visibility: hidden;
    }

    .sidebar-link[aria-current="page"] {
        transition-property: color, background-color, border-color, box-shadow;
    }

    @media (prefers-reduced-motion: reduce) {
        .sidebar-link,
        .sidebar-link > span {
            transition: none;
        }

        .sidebar-link {
            transform: none;
            will-change: auto;
        }
    }
</style>
