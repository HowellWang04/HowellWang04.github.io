---
// Where to find me for a game: a Steam card with my numbers, what I've been playing and what I've played most
// (fetched daily by scripts/fetch-steam.mjs), a PlayStation card with my online ID, and a Nintendo Switch card with
// what I've played lately (fetched daily by scripts/fetch-nintendo.mjs).
import LocalizedText from "./LocalizedText.astro";
import steam from "../data/steam.json";
import nintendo from "../data/nintendo.json";
import { siNintendoswitch, siPlaystation, siSteam } from "simple-icons";
import { PSN_ID, STEAM_ID, SWITCH_FRIEND_CODE } from "../config";

const steamUrl = `https://steamcommunity.com/profiles/${STEAM_ID}/`;
const psnUrl = `https://profile.playstation.com/${PSN_ID}`;
const hours = (minutes: number) => (minutes / 60).toFixed(1);
// Long playtimes in whole hours, short ones to a tenth.
const libraryHours = (minutes: number) => minutes >= 600 ? Math.round(minutes / 60).toLocaleString("en-US") : hours(minutes);
// Most games keep their cover at this address; the few that don't fall back to their icon (see the script).
const cover = (appid: number) => `https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/${appid}/header.jpg`;
// Galgames stay off the library list, by app ID.
const hiddenGames = new Set([
  2458530, // 魔女的夜宴
  1044620, // Aokana - Four Rhythms Across the Blue
  1200110, // Memories Off -Innocent Fille- for Dearest
  1293820, // YOU and ME and HER: A Love Story
  3682050, // Sickly Days and Summer Traces
  412830, // STEINS;GATE
  825630, // STEINS;GATE 0
  970560, // STEINS;GATE: My Darling's Embrace
]);
// The library lists the games I've played, galgames aside.
const library = (steam.library ?? []).filter((game) => game.minutes > 0 && !hiddenGames.has(game.appid));
const sorts = [
  { key: "most", en: "Playtime, most first", zh: "游玩时长从高到低" },
  { key: "least", en: "Playtime, least first", zh: "游玩时长从低到高" },
  { key: "name", en: "Name, A to Z", zh: "名称 A 到 Z" },
  { key: "nameReverse", en: "Name, Z to A", zh: "名称 Z 到 A" },
];

// The numbers across the top of the Steam card; the ones Steam didn't share are left out.
const stats = [
  { value: steam.level, en: "Level", zh: "等级" },
  { value: steam.gameCount, en: "Games", zh: "游戏数" },
  { value: steam.minutesTotal && Math.round(steam.minutesTotal / 60).toLocaleString("en-US"), en: "Hours played", zh: "累计小时" },
  { value: steam.memberSince, en: "On Steam since", zh: "入坑年份" },
].filter(({ value }) => value);
---

<section id="play" class="scroll-mt-20 pt-16">
  <!-- Doodled like My Favorite Video Games (index.astro draws it): a highlighter swipe and a line-drawn handheld
       console, with a screen, a d-pad and two buttons. -->
  <div class="text-3xl w-full font-bold font-heading mb-5" data-reveal>
    <span class="doodle-heading">
      <LocalizedText en="Find Me on Every Platform" zh="各个游戏平台都有我的身影" />
      <svg class="doodle-stroke" aria-hidden="true">
        <path class="doodle-line" />
        <g class="doodle-icon">
          <path d="M9 4H39C43 4 46 7 46 11V21C46 25 43 28 39 28H9C5 28 2 25 2 21V11C2 7 5 4 9 4Z" />
          <path d="M17 9H31C32.1 9 33 9.9 33 11V21C33 22.1 32.1 23 31 23H17C15.9 23 15 22.1 15 21V11C15 9.9 15.9 9 17 9Z" />
          <path d="M8.5 13v6M5.5 16h6" />
          <circle cx="38" cy="14" r="1.2" />
          <circle cx="41" cy="18.5" r="1.2" />
        </g>
      </svg>
    </span>
  </div>
  <div class="play-grid">
    <!-- The whole card links to my Steam profile (the link's ::after covers it), except the library button. -->
    <div class="play-card play-card-steam reveal-card rounded-lg bg-base-100" data-reveal>
      <span class="play-platform">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siSteam.path} /></svg>
        <a class="play-link" href={steamUrl} target="_blank" rel="noopener noreferrer">Steam</a>
        <svg class="play-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg>
      </span>
      {steam.level !== null && (
        <span class="play-tiles" data-reveal-children>
          {stats.map(({ value, en, zh }) => (
            <span class="play-tile">
              <span class="play-tile-value">{value}</span>
              <span class="play-tile-label"><LocalizedText en={en} zh={zh} /></span>
            </span>
          ))}
        </span>
      )}
      {steam.recent.length > 0 && (
        <span class="play-recent" data-reveal-children>
          <span class="play-label">
            <LocalizedText en="Recently played" zh="最近在玩" />
            {steam.minutesTwoWeeks ? <LocalizedText
              en={`${hours(steam.minutesTwoWeeks)} h in two weeks`}
              zh={`两周 ${hours(steam.minutesTwoWeeks)} 小时`} /> : null}
          </span>
          {steam.recent.map((game) => (
            <span class="play-game">
              {game.image && <img src={game.image} alt="" width="460" height="215" loading="lazy" />}
              <span class="play-game-info">
                <span class="play-game-name">{game.name}</span>
                {/* Achievement progress, for games that have achievements. */}
                {game.achievements && (
                  <span class="play-achievements">
                    <span class="play-bar"><span style={`--done: ${game.achievements.done / game.achievements.total}`}></span></span>
                    <span class="play-achievements-count">{game.achievements.done}/{game.achievements.total}</span>
                  </span>
                )}
              </span>
              <span class="play-game-hours">{hours(game.minutesTwoWeeks)} h</span>
            </span>
          ))}
        </span>
      )}
      {steam.favorites.length > 0 && (
        <span class="play-recent" data-reveal-children>
          <span class="play-label"><LocalizedText en="Most played" zh="最长游玩" /></span>
          {steam.favorites.map((game) => (
            <span class="play-game">
              {game.image && <img src={game.image} alt="" width="460" height="215" loading="lazy" />}
              <span class="play-game-info">
                <span class="play-game-name">{game.name}</span>
              </span>
              <span class="play-game-hours">{Math.round(game.minutes / 60).toLocaleString("en-US")} h</span>
            </span>
          ))}
        </span>
      )}
      {library.length > 0 && (
        <button type="button" class="play-library-open" data-library-open>
          <LocalizedText en="Browse my Steam library" zh="浏览我的 Steam 游戏库" />
          <span aria-hidden="true">→</span>
        </button>
      )}
      {steam.level === null ? (
        <span class="play-note"><LocalizedText en="Add me as a friend on Steam" zh="在 Steam 上添加我为好友" /></span>
      ) : (
        <span class="play-source"><LocalizedText en="Fetched daily from the Steam Web API" zh="数据每日从 Steam Web API 抓取" /></span>
      )}
    </div>

    <div class="play-side">
      <a class="play-card reveal-card rounded-lg bg-base-100" href={psnUrl} target="_blank" rel="noopener noreferrer" data-reveal>
        <span class="play-platform">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siPlaystation.path} /></svg>
          PlayStation
          <svg class="play-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg>
        </span>
        <span class="play-id font-heading">{PSN_ID}</span>
        <span class="play-note"><LocalizedText en="Add me as a friend on PlayStation" zh="在 PlayStation 上添加我为好友" /></span>
      </a>

      <!-- Nintendo has no public profile to link to, so this card is just a card. -->
      <div class="play-card play-card-still reveal-card rounded-lg bg-base-100" data-reveal>
        <span class="play-platform">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siNintendoswitch.path} /></svg>
          Nintendo Switch
        </span>
        <!-- Friend codes have to be typed in on the console, so a click copies it. -->
        <button type="button" class="play-copy" data-copy={SWITCH_FRIEND_CODE}>
          <span class="play-id font-heading">{SWITCH_FRIEND_CODE}</span>
          <span class="play-copy-mark">
            <svg class="play-copy-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V5a1 1 0 0 1 1-1h9" /></svg>
            <span class="play-copied" data-copied hidden><LocalizedText en="Copied" zh="已复制" /></span>
          </span>
        </button>
        <span class="play-note"><LocalizedText en="Add me as a friend on Switch" zh="在 Switch 上添加我为好友" /></span>
        {nintendo.recent.length > 0 && (
          <>
            <span class="play-tiles play-tiles-two" data-reveal-children>
              <span class="play-tile">
                <span class="play-tile-value">{hours(nintendo.minutesRecent)}</span>
                <span class="play-tile-label"><LocalizedText en="Hours this month" zh="近一个月小时" /></span>
              </span>
              <span class="play-tile">
                <span class="play-tile-value">{nintendo.daysPlayed}</span>
                <span class="play-tile-label"><LocalizedText en="Days played" zh="游玩天数" /></span>
              </span>
            </span>
            <span class="play-recent" data-reveal-children>
              <span class="play-label"><LocalizedText en="Recently played" zh="最近在玩" /></span>
              {nintendo.recent.map((game) => (
                <span class="play-game">
                  {game.image && <img class="play-icon" src={game.image} alt="" width="256" height="256" loading="lazy" />}
                  <span class="play-game-info">
                    <!-- Named in English on the English page when the fetch found an English name. -->
                    <span class="play-game-name play-game-name-full" data-en={game.nameEn ?? game.name} data-zh={game.name}>{game.nameEn ?? game.name}</span>
                  </span>
                  <span class="play-game-hours">{hours(game.minutes)} h</span>
                </span>
              ))}
            </span>
            <span class="play-source"><LocalizedText en="Fetched daily from the Switch Parental Controls API" zh="数据每日从任天堂 Switch 家长控制 API 抓取" /></span>
          </>
        )}
      </div>
    </div>
  </div>

  {library.length > 0 && (
    <dialog class="library-dialog bg-base-100 text-base-content" data-library data-lenis-prevent aria-labelledby="library-title">
      <div data-dialog-scroll>
        <header class="library-header bg-base-100">
          <div>
            <h2 id="library-title" class="library-title">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siSteam.path} /></svg>
              <LocalizedText en="My Steam Library" zh="我的 Steam 游戏库" />
            </h2>
            <div class="library-sort">
              <label for="library-sort"><LocalizedText en="Sort by" zh="排序" /></label>
              <span class="library-sort-field">
                <select id="library-sort" data-library-sort>
                  {sorts.map(({ key, en, zh }) => <option value={key} data-en={en} data-zh={zh}>{en}</option>)}
                </select>
              </span>
            </div>
          </div>
          <button type="button" class="library-close" data-library-close>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            <span class="sr-only"><LocalizedText en="Close" zh="关闭" /></span>
          </button>
        </header>
        <ul class="library-grid">
          {library.map((game) => (
            <li class="library-game" data-minutes={game.minutes} data-name={game.name}>
              <img src={cover(game.appid)} data-icon={game.icon} alt="" width="460" height="215" loading="lazy" />
              <span class="library-name" title={game.name}>{game.name}</span>
              <span class="library-hours">{libraryHours(game.minutes)} h</span>
            </li>
          ))}
        </ul>
        <p class="library-note">
          <LocalizedText en="Games I haven't played yet aren't listed." zh="还没玩过的游戏没有列出。" />
        </p>
      </div>
    </dialog>
  )}
</section>

<script>
  import { lenis } from "../scripts/smooth-scroll";
  import { attachScrollbar } from "../scripts/dialog-scrollbar";

  // Copies the Switch friend code and says so for a moment.
  const setupCopy = () => {
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = "true";
      const copied = button.querySelector<HTMLElement>("[data-copied]")!;
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy!);
        } catch {
          return;
        }
        copied.hidden = false;
        window.setTimeout(() => (copied.hidden = true), 1600);
      });
    });
  };

  setupCopy();
  document.addEventListener("astro:page-load", setupCopy);

  // The Steam library opens in a dialog that scrolls on its own; the page holds still behind it.
  const setupLibrary = () => {
    const dialog = document.querySelector<HTMLDialogElement>("[data-library]");
    const open = document.querySelector<HTMLButtonElement>("[data-library-open]");
    if (!dialog || !open || dialog.dataset.bound) return;
    dialog.dataset.bound = "true";
    const scroller = attachScrollbar(dialog);
    const still = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const easing = "cubic-bezier(0.2, 1, 0.3, 1)";

    // The first screenful of games cascades in, on opening and after each sort.
    const cascade = (start: number) => {
      dialog.querySelectorAll<HTMLElement>(".library-game").forEach((game, index) => {
        game.getAnimations().forEach((animation) => animation.cancel());
        if (index > 15) return;
        game.animate(
          [{ opacity: 0, translate: "0 16px" }, { opacity: 1, translate: "0 0" }],
          { duration: 520, delay: start + index * 40, easing, fill: "backwards" },
        );
      });
    };

    open.addEventListener("click", () => {
      lenis?.stop();
      dialog.showModal();
      scroller.scrollTop = 0;
      if (still()) return;
      dialog.animate([{ opacity: 0, transform: "translateY(16px)" }, { opacity: 1, transform: "none" }], { duration: 420, easing });
      cascade(100);
    });
    dialog.querySelector("[data-library-close]")!.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => lenis?.start());

    // The games come most played first; the sort menu reorders them in place.
    const grid = dialog.querySelector<HTMLElement>(".library-grid")!;
    const games = [...grid.children] as HTMLElement[];
    const byName = new Intl.Collator(["en", "zh"], { numeric: true, sensitivity: "base" });
    const orders: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      most: (a, b) => Number(b.dataset.minutes) - Number(a.dataset.minutes),
      least: (a, b) => Number(a.dataset.minutes) - Number(b.dataset.minutes),
      name: (a, b) => byName.compare(a.dataset.name!, b.dataset.name!),
      nameReverse: (a, b) => byName.compare(b.dataset.name!, a.dataset.name!),
    };
    const sort = dialog.querySelector<HTMLSelectElement>("[data-library-sort]")!;
    sort.addEventListener("change", () => {
      grid.append(...[...games].sort(orders[sort.value]));
      scroller.scrollTop = 0;
      if (!still()) cascade(0);
    });

    // A game whose cover isn't at the usual address shows its small icon instead, or an empty tile without one.
    dialog.addEventListener("error", (event) => {
      const image = event.target as HTMLImageElement;
      if (!(image instanceof HTMLImageElement)) return;
      if (image.dataset.icon && !image.classList.contains("is-icon")) {
        image.classList.add("is-icon");
        image.src = image.dataset.icon;
      } else {
        // A transparent pixel, so only the tile's background shows instead of a broken image mark.
        image.src = "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
      }
    }, true);
  };

  setupLibrary();
  document.addEventListener("astro:page-load", setupLibrary);
</script>

<style>
  /* minmax(0, ...) lets a long game name shorten with an ellipsis instead of widening the card. */
  .play-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .play-grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }

  .play-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    transition: transform 240ms ease, box-shadow 240ms ease;
  }

  .play-card:hover {
    transform: translateY(-3px);
  }

  /* The Nintendo card links nowhere, so it doesn't lift as if it could be clicked. */
  .play-card-still:hover {
    transform: none;
  }

  /* PlayStation and Nintendo stack in the right-hand column. */
  .play-side {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  /* The two columns end level: the Switch card stretches to meet the bottom of the Steam card. */
  .play-side > :last-child {
    flex-grow: 1;
  }

  .play-platform {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .play-platform svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: currentColor;
  }

  /* An "opens elsewhere" mark: a box with an arrow leaving it, which nudges up and out on hover. */
  .play-platform .play-arrow {
    width: 1.15rem;
    height: 1.15rem;
    margin-left: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.5;
    transition: transform 240ms ease, opacity 240ms ease;
  }

  .play-card:hover .play-arrow {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  /* A row of small number tiles: big figure, small label under it. */
  .play-tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  @media (min-width: 1100px) {
    .play-tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .play-tiles.play-tiles-two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .play-tile {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 0.75rem;
    border-radius: 0.6rem;
    background: color-mix(in srgb, currentColor 5%, transparent);
  }

  .play-tile-value {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .play-tile-label {
    font-size: 0.75rem;
    opacity: 0.6;
  }

  .play-recent {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6rem;
  }

  .play-label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .play-game {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .play-game img {
    width: 5.5rem;
    height: auto;
    flex-shrink: 0;
    border-radius: 0.35rem;
  }

  /* Switch games come with square icons rather than wide headers. */
  .play-game img.play-icon {
    width: 2.6rem;
    height: 2.6rem;
    object-fit: cover;
    border-radius: 0.5rem;
  }

  .play-game-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    flex: 1;
  }

  .play-game-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The Switch card is narrow and its English names run long (The Legend of Zelda: Ocarina of Time), so its names
     are a little smaller and may take two lines instead of being cut short. */
  .play-game-name-full {
    display: -webkit-box;
    font-size: 0.875rem;
    line-height: 1.3;
    white-space: normal;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  /* Achievement progress: a thin bar that fills to the share unlocked, with the count beside it. */
  .play-achievements {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
  }

  .play-bar {
    flex: 1;
    height: 0.3rem;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 12%, transparent);
  }

  .play-bar span {
    display: block;
    width: calc(var(--done) * 100%);
    height: 100%;
    border-radius: inherit;
    background: oklch(var(--p));
  }

  .play-achievements-count {
    flex-shrink: 0;
    font-family: var(--font-heading);
    opacity: 0.6;
  }

  .play-game-hours {
    margin-left: auto;
    flex-shrink: 0;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    opacity: 0.7;
  }

  /* The friend code reads like the PlayStation ID, with a copy mark that answers "Copied" when clicked. */
  .play-copy {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;
    text-align: left;
  }

  .play-copy-icon {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.5;
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .play-copy:hover .play-copy-icon {
    opacity: 1;
    transform: scale(1.1);
  }

  /* "Copied" floats just above the mark, so it never pushes the code onto a second line. */
  .play-copy-mark {
    position: relative;
    display: inline-flex;
  }

  .play-copied {
    position: absolute;
    bottom: calc(100% + 0.3rem);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.8rem;
    color: oklch(var(--p));
  }

  .play-id {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .play-note {
    font-size: 0.9rem;
    opacity: 0.7;
  }

  /* Where the numbers come from, in small print at the foot of the card. */
  .play-source {
    margin-top: auto;
    font-size: 0.68rem;
    font-style: italic;
    opacity: 0.45;
  }

  /* The Steam card is a box with a link in it rather than a link, so it can also hold the library button. The link
     stretches over the whole card; the button sits above it. */
  .play-card-steam {
    position: relative;
  }

  .play-link::after {
    content: "";
    position: absolute;
    inset: 0;
