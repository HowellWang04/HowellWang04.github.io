---
import LocalizedText from "./LocalizedText.astro";
import CoverPlaceholder from "./CoverPlaceholder.astro";
import { projectDetails } from "../data/projectDetails";

const { projectId, title, titleZh, desc, descZh, img, coverPending, coverComingSoon } = Astro.props;
const details = projectDetails[projectId] ?? {};
const dialogId = `project-details-${projectId}`;
const pending = { en: "Not yet documented", zh: "尚待补充" };
const facts = [
  { label: { en: "My role", zh: "我的角色" }, value: details.role },
  { label: { en: "Team", zh: "团队背景" }, value: details.team },
  { label: { en: "Timeline", zh: "开发周期" }, value: details.duration },
];
---

<project-details class="block">
  <dialog id={dialogId} class="project-dialog" aria-labelledby={`${dialogId}-title`} data-lenis-prevent>
    <div class="project-sheet bg-base-100 text-base-content text-left">
      <header class="project-header border-b border-base-300 bg-base-100">
        <div>
          <p class="text-sm opacity-60"><LocalizedText en="Project breakdown" zh="项目详解" /></p>
          <h2 id={`${dialogId}-title`} class="text-2xl sm:text-3xl font-bold mt-1">{titleZh ? <LocalizedText en={title} zh={titleZh} /> : title}</h2>
        </div>
        <form method="dialog">
          <button class="btn btn-sm btn-ghost rounded-full" autofocus>
            <LocalizedText en="Close" zh="关闭" /><span aria-hidden="true">×</span>
          </button>
        </form>
      </header>

      <div class="project-body">
        <div class="project-overview">
          {coverPending ? <CoverPlaceholder class="w-36 shrink-0" comingSoon={coverComingSoon} /> : img && <img src={img} alt={title} class="project-cover rounded-xl" loading="lazy" />}
          <div>
            <p class="text-base leading-relaxed"><LocalizedText en={desc} zh={descZh ?? desc} /></p>
          </div>
        </div>

        <dl class="project-facts rounded-xl bg-base-200">
          {facts.map(({ label, value }) => (
            <div>
              <dt class="text-sm opacity-60 mb-2"><LocalizedText {...label} /></dt>
              <dd class:list={["text-base", !value && "opacity-60"]}><LocalizedText {...(value ?? pending)} /></dd>
            </div>
          ))}
        </dl>

        <section class="project-section">
          <h3 class="text-lg font-bold">{details.contributionGroups?.length ? <LocalizedText en="My Contributions & Implementation" zh="我的贡献与技术实现" /> : <LocalizedText en="Tools & technology" zh="技术栈与工具" />}</h3>
          {details.contributionGroups?.length ? (
            <div class="tech-grid">
              {details.contributionGroups.map((group) => (
                <article class="tech-card bg-base-200 border border-base-300">
                  <h4 class="tech-title"><LocalizedText {...group.title} /></h4>
                  <p class="tech-tools">{group.tools}</p>
                  <p class="tech-summary"><LocalizedText {...group.summary} /></p>
                  <details class="tech-details border-t border-base-300">
                    <summary><LocalizedText en="Implementation details" zh="实现细节" /></summary>
                    <div class="tech-detail-body">
                      {group.details.map((paragraph) => <p><LocalizedText {...paragraph} /></p>)}
                    </div>
                  </details>
                </article>
              ))}
            </div>
          ) : details.stack?.length ? (
            <ul class="grid gap-3 mt-4">
              {details.stack.map((tool) => (
                <li class="flex flex-col sm:flex-row gap-2 sm:gap-4">
                  <span class="badge badge-outline h-auto min-h-6 py-1 shrink-0">{tool.name}</span>
                  <p class="text-base leading-relaxed"><LocalizedText {...tool.use} /></p>
                </li>
              ))}
            </ul>
          ) : <p class="text-base opacity-60 mt-3"><LocalizedText {...pending} /></p>}
        </section>

        {!details.contributionGroups?.length && <section class="project-section">
          <h3 class="text-lg font-bold"><LocalizedText en="What I owned & delivered" zh="我负责并完成的工作" /></h3>
          {details.contributions?.length ? (
            <ul class="list-disc pl-5 mt-3 space-y-3 text-base leading-relaxed">
              {details.contributions.map((contribution) => <li><LocalizedText {...contribution} /></li>)}
            </ul>
          ) : <p class="text-base opacity-60 mt-3"><LocalizedText en="My individual responsibilities and contributions will be added here." zh="我的具体职责与个人贡献尚待补充。" /></p>}
        </section>}

        {details.links?.length && <div class="project-links flex flex-wrap gap-3 mt-8">
          {details.links.map((link) => <a class="btn btn-sm btn-primary rounded-full" href={link.url} target="_blank" rel="noopener noreferrer"><LocalizedText {...link.label} /><span aria-hidden="true">↗</span></a>)}
        </div>}

      </div>
    </div>
  </dialog>
</project-details>

<script>
  import { lenis } from "../scripts/smooth-scroll";

  class ProjectDetails extends HTMLElement {
    connectedCallback() {
      if (this.dataset.bound) return;
      this.dataset.bound = "true";
      const dialog = this.querySelector<HTMLDialogElement>("dialog")!;
      const trigger = this.parentElement!.querySelector<HTMLButtonElement>("[data-project-open]")!;

      // Start fetching the cover as soon as the card is hovered or focused, so it doesn't pop in mid-animation.
      const preloadCover = () => dialog.querySelectorAll("img").forEach((img) => { img.loading = "eager"; });
      trigger.addEventListener("pointerenter", preloadCover, { once: true });
      trigger.addEventListener("focus", preloadCover, { once: true });

      trigger.addEventListener("click", () => {
        preloadCover();
        // The dialog scrolls on its own (data-lenis-prevent); hold the page still behind it.
        lenis?.stop();
        dialog.showModal();
        this.playOpenAnimation(dialog);
      });
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });

      dialog.querySelectorAll<HTMLDetailsElement>(".tech-details").forEach((details) => this.bindDetails(details));
      // Start every visit with all details collapsed and the cards back to equal row heights.
      dialog.addEventListener("close", () => {
        lenis?.start();
        dialog.querySelectorAll<HTMLDetailsElement>(".tech-details").forEach((details) => { details.open = false; });
        dialog.querySelectorAll<HTMLElement>(".tech-grid").forEach((grid) => this.unlockCardHeights(grid));
      });
    }

    // Cards in a row stretch to equal height. Before a card grows, pin each card's current height as its minimum
    // and stop stretching, so only the expanding card gets taller and its neighbour keeps its size.
    lockCardHeights(grid: HTMLElement) {
      if (grid.dataset.locked) return;
      grid.dataset.locked = "true";
      grid.querySelectorAll<HTMLElement>(".tech-card").forEach((card) => {
        card.style.minHeight = `${card.getBoundingClientRect().height}px`;
      });
      grid.style.alignItems = "start";
    }

    unlockCardHeights(grid: HTMLElement) {
      delete grid.dataset.locked;
      grid.style.alignItems = "";
      grid.querySelectorAll<HTMLElement>(".tech-card").forEach((card) => { card.style.minHeight = ""; });
    }

    bindDetails(details: HTMLDetailsElement) {
      const summary = details.querySelector("summary")!;
      const body = details.querySelector<HTMLElement>(".tech-detail-body")!;
      const easing = "cubic-bezier(0.22, 1, 0.36, 1)";
      let animation: Animation | undefined;
      let fade: Animation | undefined;
      let expanded = details.open;

      summary.addEventListener("click", (event) => {
        event.preventDefault();
        this.lockCardHeights(details.closest<HTMLElement>(".tech-grid")!);
        const startHeight = details.getBoundingClientRect().height;
        animation?.cancel();
        fade?.cancel();
        expanded = !expanded;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          details.open = expanded;
          return;
        }

        details.open = true;
        const openHeight = details.getBoundingClientRect().height;
        const endHeight = expanded ? openHeight : openHeight - body.getBoundingClientRect().height;
        details.style.overflow = "hidden";
        animation = details.animate(
          { height: [`${startHeight}px`, `${endHeight}px`] },
          { duration: 420, easing },
        );
        // The text fades in as the panel opens, and fades out quickly before the panel finishes closing.
        fade = body.animate(
          expanded
            ? [{ opacity: 0, transform: "translateY(-4px)" }, { opacity: 1, transform: "none" }]
            : [{ opacity: 1 }, { opacity: 0 }],
          { duration: expanded ? 420 : 200, easing, fill: "both" },
        );
        animation.onfinish = () => {
          details.open = expanded;
          details.style.overflow = "";
          fade?.cancel();
          animation = fade = undefined;
        };
      });
    }

    playOpenAnimation(dialog: HTMLDialogElement) {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const easing = "cubic-bezier(0.22, 1, 0.36, 1)";

      // No scale: scaling text makes it snap visibly when the animation ends.
      dialog.animate(
        [
          { opacity: 0, transform: "translateY(12px)" },
          { opacity: 1, transform: "none" },
        ],
        { duration: 420, easing },
      );

      // Sections cascade in one after another, then each contribution card follows in turn.
      const items = dialog.querySelectorAll<HTMLElement>(
        ".project-overview, .project-facts, .project-section > h3, .tech-card, .project-section li, .project-section > p, .project-links",
      );
      items.forEach((item, index) => {
        item.animate(
          [
            { opacity: 0, transform: "translateY(8px)" },
            { opacity: 1, transform: "none" },
          ],
          { duration: 520, delay: 120 + Math.min(index * 70, 700), easing, fill: "backwards" },
        );
      });
    }
  }

  if (!customElements.get("project-details")) {
    customElements.define("project-details", ProjectDetails);
  }
</script>

<style>
  .project-dialog {
    width: min(56rem, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 1.25rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow: 0 24px 80px rgb(0 0 0 / 30%);
  }

  .project-dialog::backdrop {
    background: rgb(10 12 18 / 65%);
    backdrop-filter: blur(4px);
    animation: backdrop-in 320ms ease;
  }

  @keyframes backdrop-in {
    from { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-dialog::backdrop { animation: none; }
  }

  :global(html:has(.project-dialog[open])) {
    overflow: hidden;
  }

  .project-header {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 2rem;
  }

  .project-header form { flex-shrink: 0; }
  .project-body { padding: 2rem; }
  .project-overview { display: flex; gap: 1.5rem; align-items: center; }
  .project-cover { width: 9rem; height: 7.25rem; object-fit: cover; flex-shrink: 0; }
  .project-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; padding: 1.25rem; margin-top: 1.75rem; }
  .project-section { margin-top: 2rem; }
  .tech-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
  .tech-card { display: flex; flex-direction: column; min-width: 0; padding: 1.25rem; border-radius: 0.875rem; }
  .tech-title { font-size: 1rem; font-weight: 700; line-height: 1.5; }
  .tech-tools { min-height: 3em; margin-top: 0.375rem; font-size: 0.8125rem; line-height: 1.5; opacity: 0.65; overflow-wrap: anywhere; }
  .tech-summary { margin: 0.875rem 0 1rem; font-size: 0.9375rem; line-height: 1.75; }
  .tech-details { margin-top: auto; padding-top: 0.75rem; }
  .tech-details summary { cursor: pointer; width: fit-content; font-size: 0.8125rem; font-weight: 600; line-height: 1.75; }
  .tech-details summary:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 0.125rem; }
  .tech-detail-body { display: grid; gap: 0.75rem; padding-top: 0.875rem; font-size: 0.875rem; line-height: 1.75; }

  @media (max-width: 600px) {
    .project-header { padding: 1rem; }
    .project-body { padding: 1.25rem; }
    .project-overview { flex-direction: column; align-items: flex-start; }
    .project-cover { width: 7rem; height: auto; }
    .project-facts { grid-template-columns: 1fr; gap: 1rem; }
    .tech-grid { grid-template-columns: 1fr; }
    .tech-tools { min-height: 0; }
  }
</style>
