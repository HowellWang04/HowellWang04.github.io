---
import LocalizedText from "../LocalizedText.astro";
import resumes from "../../data/resume.json";

const versions = [
  { language: "en", resume: resumes.en, mdLabel: "Download Markdown", pdfLabel: "Download PDF" },
  { language: "zh", resume: resumes.zh, mdLabel: "下载 Markdown", pdfLabel: "下载 PDF" },
];

// Titles read "Name  |  Role" and metas start with the date: the date goes to the right, the role joins the detail line.
const splitEntry = (entry: { title: string; meta?: string }) => {
  const [name, role] = entry.title.split("  |  ");
  const [date, ...details] = entry.meta ? entry.meta.split("  ·  ") : [];
  return { name, date, details: [role, ...details].filter(Boolean).join("  ·  ") };
};
---

<section id="resume" class="resume-page scroll-mt-20">
    <header class="resume-toolbar">
      <h2 class="text-3xl font-bold" data-reveal><LocalizedText en="Resume" zh="个人简历" /></h2>
      {versions.map(({ language, mdLabel, pdfLabel }) => (
        <div class="resume-downloads" data-resume-lang={language}>
          <a class="btn btn-sm btn-outline btn-primary" data-reveal href={`/resume/guanhao-wang-cv-${language}.md`} download>
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5" /></svg>
            {mdLabel}
          </a>
          <a class="btn btn-sm btn-outline btn-primary" data-reveal href={`/resume/guanhao-wang-cv-${language}.pdf`} download>
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5" /></svg>
            {pdfLabel}
          </a>
        </div>
      ))}
    </header>

    {versions.map(({ language, resume }) => (
      <article class="resume-document" data-resume-lang={language} lang={language === "zh" ? "zh-CN" : "en"}>
        <header class="resume-intro border-b border-base-300">
          <h2 class="resume-name" data-reveal>{resume.name}</h2>
          <p class="resume-contact" data-reveal>{resume.contact}</p>
          <div class="resume-links" data-reveal>
            {resume.links.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}
          </div>
          <p class="resume-summary" data-reveal>{resume.summary}</p>
        </header>

        {resume.sections.map((section) => (
          <section class="resume-section">
            <h2 class="resume-section-title border-b border-base-300" data-reveal>{section.title}</h2>
            <div class="resume-entries">
              {section.entries.map((entry) => {
                if ("description" in entry) return (
                  <div class="resume-skill" data-reveal>
                    <h3 class="resume-entry-name">{entry.title}</h3>
                    <p>{entry.description}</p>
                  </div>
                );
                const { name, date, details } = splitEntry(entry);
                return (
                <div class="resume-entry" data-reveal>
                  <div class="resume-entry-head">
                    <h3 class="resume-entry-name">{name}</h3>
                    {date && <span class="resume-date">{date}</span>}
                  </div>
                  {details && <p class="resume-meta">{details}</p>}
                  {"bullets" in entry && <ul class="resume-bullets">
                    {entry.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>}
                  {"links" in entry && <div class="resume-links mt-3">
                    {entry.links.map((link) => <a href={link.url} download={"download" in link && link.download} target={"download" in link && link.download ? undefined : "_blank"} rel="noopener noreferrer">{link.label} <span aria-hidden="true">{"download" in link && link.download ? "↓" : "↗"}</span></a>)}
                  </div>}
                </div>
                );
              })}
            </div>
          </section>
        ))}
      </article>
    ))}
</section>

<style>
  .resume-page { width: 100%; }
  .resume-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 2.5rem; }
  .resume-downloads { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .resume-intro { padding-bottom: 1.75rem; }
  .resume-name { font-size: 2.25rem; font-weight: 700; line-height: 1.15; }
  .resume-contact { margin-top: 0.75rem; font-size: 0.9375rem; line-height: 1.75; overflow-wrap: anywhere; opacity: 0.8; }
  .resume-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; font-size: 0.875rem; }
  .resume-links a { color: oklch(var(--p)); text-decoration: underline; text-underline-offset: 0.2em; }
  .resume-links a:hover { opacity: 0.75; }
  .resume-summary { margin-top: 1.25rem; line-height: 1.75; }
  .resume-section { margin-top: 2.5rem; }
  /* Courier Prime caps with wide tracking read as labels, so the entries below carry the weight. */
  .resume-section-title { padding-bottom: 0.625rem; font-size: 1rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: oklch(var(--p)); }
  .resume-entries { display: grid; gap: 1.5rem; padding-top: 1.25rem; }
  .resume-entry-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.125rem 1.5rem; }
  /* Entry names use the serif body face; long monospace names crowded the line. WenKai Medium carries the Chinese weight. */
  .resume-entry-name { font-family: "Source Serif 4", "LXGW WenKai GB Medium", "LXGW WenKai GB", Georgia, serif; font-size: 1.0625rem; font-weight: 600; line-height: 1.4; }
  .resume-date { font-size: 0.875rem; font-variant-numeric: tabular-nums; white-space: nowrap; opacity: 0.7; }
  .resume-meta { margin-top: 0.25rem; font-size: 0.875rem; font-style: italic; line-height: 1.6; opacity: 0.7; }
  :lang(zh-CN) .resume-meta { font-style: normal; }
  .resume-bullets { display: grid; gap: 0.5rem; margin-top: 0.75rem; padding-left: 1.25rem; list-style: disc; line-height: 1.7; }
  .resume-bullets li::marker { color: oklch(var(--p) / 0.6); }
  .resume-skill { display: grid; grid-template-columns: 11rem 1fr; gap: 0.25rem 1.5rem; align-items: baseline; }
  .resume-skill .resume-entry-name { font-size: 1rem; }
  .resume-section:has(.resume-skill) .resume-entries { gap: 0.75rem; }
  @media (max-width: 640px) {
    .resume-skill { grid-template-columns: 1fr; }
  }
  [data-resume-lang="zh"] { display: none; }
  :global(html:lang(zh-CN)) [data-resume-lang="en"] { display: none; }
  :global(html:lang(zh-CN)) article[data-resume-lang="zh"] { display: block; }
  :global(html:lang(zh-CN)) .resume-downloads[data-resume-lang="zh"] { display: flex; }
</style>
