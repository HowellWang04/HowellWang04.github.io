---
const { title, titleZh, img, coverPending, coverComingSoon, desc, descZh, url, badge, category, teamProject, tags, projectId, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
import LocalizedText from "./LocalizedText.astro";
import ProjectDetails from "./ProjectDetails.astro";
import CoverPlaceholder from "./CoverPlaceholder.astro";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
const categories = {
  "game-jam": { en: "Game Jam", zh: "Game Jam", color: "badge-secondary" },
  university: { en: "University Project", zh: "校内项目", color: "badge-info" },
  personal: { en: "Personal Project", zh: "个人项目", color: "badge-info" },
};
const categoryInfo = category && categories[category];
const CardContent = projectId ? "div" : "a";
---

<div
  class="reveal-card relative rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  {projectId && <button type="button" class="absolute inset-0 rounded-lg cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-4" data-project-open aria-haspopup="dialog" aria-controls={`project-details-${projectId}`}>
    <span class="sr-only"><LocalizedText en={`View ${title} details`} zh={`查看 ${titleZh ?? title} 项目详情`} /></span>
  </button>}
  <CardContent href={projectId ? undefined : url} target={projectId ? undefined : target}>
    <div class="hero-content flex-col md:flex-row">
      {
        coverPending ? <CoverPlaceholder class="w-full md:w-52 shrink-0" comingSoon={coverComingSoon} /> : img && (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {titleZh ? <LocalizedText en={title} zh={titleZh} /> : title}
          <span class="inline-flex flex-wrap items-center gap-2 ml-2 align-middle">
            {categoryInfo ? (
              <span class:list={["badge", categoryInfo.color]}>
                <LocalizedText en={categoryInfo.en} zh={categoryInfo.zh} />
              </span>
            ) : badge && <span class="badge badge-secondary">{badge}</span>}
            {teamProject && <span class="badge badge-success">
              <LocalizedText en="Team Project" zh="团队项目" />
            </span>}
          </span>
        </h1>
        <p class="py-1 text-1xl">{descZh ? <LocalizedText en={desc} zh={descZh} /> : desc}</p>
        <div class="card-actions justify-end">
          {
            tags &&
              tags.map((tag) => (
                <a href={`${tag_url}/${tag}`} class="relative z-10 badge badge-outline">
                  {tag}
                </a>
              ))
          }
        </div>
      </div>
    </div>
  </CardContent>
  {projectId && <div class="px-4 pb-4 text-right">
    <a href={url} target={target} rel="noopener noreferrer" class="relative z-10 btn btn-sm btn-outline btn-primary rounded-full">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z" /></svg>
      GitHub <span aria-hidden="true">↗</span>
    </a>
  </div>}
  {projectId && <ProjectDetails {projectId} {title} {titleZh} {desc} {descZh} {img} {coverPending} {coverComingSoon} />}
</div>

<script>
  let observer: IntersectionObserver | undefined;

  const setupCardReveal = () => {
    const cards = document.querySelectorAll<HTMLElement>(".reveal-card");
    if (!cards.length || cards[0].dataset.revealBound) return;
    observer?.disconnect();
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    observer = new IntersectionObserver((entries) => {
      const visibleCards = entries
        .filter((entry) => entry.isIntersecting)
        .map((entry) => entry.target as HTMLElement)
        .sort((a, b) => a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1);

      visibleCards.forEach((card, index) => {
        observer!.unobserve(card);
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          card.classList.remove("card-pending");
          return;
        }
        card.animate(
          [
            { opacity: 0, transform: "translateY(-10px)" },
            { opacity: 1, transform: "translateY(0)" },
          ],
          {
            duration: 560,
            delay: Math.min(index * 90, 360),
            easing: "cubic-bezier(0.22, 1, 0.36, 1)",
            fill: "backwards",
          },
        );
        card.classList.remove("card-pending");
      });
    }, { threshold: 0.1 });

    cards.forEach((card) => {
      card.dataset.revealBound = "true";
      card.classList.add("card-pending");
      observer!.observe(card);
      card.addEventListener("focusin", () => {
        card.classList.remove("card-pending");
        observer?.unobserve(card);
      });
    });

    document.querySelectorAll<HTMLDetailsElement>(".expandable-section").forEach((section) => {
      section.addEventListener("toggle", () => {
        if (section.open) return;
        section.querySelectorAll<HTMLElement>(".reveal-card").forEach((card) => {
          card.classList.add("card-pending");
          observer!.observe(card);
        });
      });
    });
  };

  setupCardReveal();
  document.addEventListener("astro:page-load", setupCardReveal);
  document.addEventListener("astro:before-swap", () => observer?.disconnect());
</script>
