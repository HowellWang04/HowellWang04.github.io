---
const { title, img, desc, descZh, url, badge, tags, projectId, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
import LocalizedText from "./LocalizedText.astro";
import ProjectDetails from "./ProjectDetails.astro";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<div
  class="reveal-card rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row">
      {
        img && (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h1>
        <p class="py-1 text-1xl">{descZh ? <LocalizedText en={desc} zh={descZh} /> : desc}</p>
        <div class="card-actions justify-end">
          {
            tags &&
              tags.map((tag) => (
                <a href={`${tag_url}/${tag}`} class="badge badge-outline">
                  {tag}
                </a>
              ))
          }
        </div>
      </div>
    </div>
  </a>
  {projectId && <ProjectDetails {projectId} {title} {desc} {descZh} {img} />}
</div>

<script>
  let observer: IntersectionObserver | undefined;

  const setupCardReveal = () => {
    const cards = document.querySelectorAll<HTMLElement>(".reveal-card");
    if (!cards.length || cards[0].dataset.revealBound) return;
    observer?.disconnect();
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    observer = new IntersectionObserver((entries) => {
      const visibleCards = entries
        .filter((entry) => entry.isIntersecting)
        .map((entry) => entry.target as HTMLElement)
        .sort((a, b) => a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1);

      visibleCards.forEach((card, index) => {
        observer!.unobserve(card);
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          card.classList.remove("card-pending");
          return;
        }
        card.animate(
          [
            { opacity: 0, transform: "translateY(-10px)" },
            { opacity: 1, transform: "translateY(0)" },
          ],
          {
            duration: 560,
            delay: Math.min(index * 90, 360),
            easing: "cubic-bezier(0.22, 1, 0.36, 1)",
            fill: "backwards",
          },
        );
        card.classList.remove("card-pending");
      });
    }, { threshold: 0.1 });

    cards.forEach((card) => {
      card.dataset.revealBound = "true";
      card.classList.add("card-pending");
      observer!.observe(card);
      card.addEventListener("focusin", () => {
        card.classList.remove("card-pending");
        observer?.unobserve(card);
      });
    });

    document.querySelectorAll<HTMLDetailsElement>(".expandable-section").forEach((section) => {
      section.addEventListener("toggle", () => {
        if (section.open) return;
        section.querySelectorAll<HTMLElement>(".reveal-card").forEach((card) => {
          card.classList.add("card-pending");
          observer!.observe(card);
        });
      });
    });
  };

  setupCardReveal();
  document.addEventListener("astro:page-load", setupCardReveal);
  document.addEventListener("astro:before-swap", () => observer?.disconnect());
</script>
