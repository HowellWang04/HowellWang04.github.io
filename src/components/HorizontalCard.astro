---
// linkLabel / linkLabelZh name the outbound button when it isn't a GitHub repository.
// playUrl adds a "Play" button and jamUrl a "Jam entry" button next to the source link.
// portfolioPdf links this project's pages from the portfolio PDF; portfolioPages is their range there.
const { title, titleZh, img, coverPending, desc, descZh, url, playUrl, jamUrl, portfolioPdf, portfolioPages, badge, category, teamProject, tags, projectId, linkLabel, linkLabelZh, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
import LocalizedText from "./LocalizedText.astro";
import ProjectDetails from "./ProjectDetails.astro";
import CoverPlaceholder from "./CoverPlaceholder.astro";
const tag_url = (url ?? "").split("/").slice(0, -1).join("/") + "/tag";
const categories = {
  "game-jam": { en: "Game Jam", zh: "Game Jam" },
  university: { en: "University Project", zh: "校内项目" },
  "personal-game": { en: "Personal Game Project", zh: "个人游戏项目" },
  "personal-interactive": { en: "Personal Interactive Project", zh: "个人交互项目" },
  "personal-art": { en: "Personal Art Project", zh: "个人美术项目" },
};
// Shown as one quiet line after the title: the category (or the plain badge text), then whether it was a team project.
const labels = [
  (category && categories[category]) || (badge && { en: badge, zh: badge }),
  teamProject && { en: "Team Project", zh: "团队项目" },
].filter(Boolean);
// Outbound links other than Play are text links, so the one filled button stays the main action.
const linkClass = "relative z-10 inline-flex items-center gap-1.5 border-b border-primary/40 pb-0.5 text-sm font-semibold text-primary transition-colors hover:border-primary";
const CardContent = projectId ? "div" : "a";
---

<div
  data-reveal
  class="reveal-card relative rounded-lg bg-base-100 hover:shadow-xl transition-[transform,box-shadow] ease-in-out hover:scale-[102%]"
>
  {projectId && <button type="button" class="absolute inset-0 rounded-lg cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-4" data-project-open aria-haspopup="dialog" aria-controls={`project-details-${projectId}`}>
    <span class="sr-only"><LocalizedText en={`View ${title} details`} zh={`查看 ${titleZh ?? title} 项目详情`} /></span>
  </button>}
  <CardContent href={projectId ? undefined : url} target={projectId ? undefined : target}>
    <div class="hero-content flex-col md:flex-row">
      {
        coverPending ? <CoverPlaceholder class="w-full md:w-52 shrink-0" {title} /> : img && (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {titleZh ? <LocalizedText en={title} zh={titleZh} /> : title}
          {labels.length > 0 && <span class="ml-2 font-sans text-sm font-normal opacity-60">
            {labels.map((label, index) => <>{index > 0 && " · "}<LocalizedText en={label.en} zh={label.zh} /></>)}
          </span>}
        </h1>
        <p class="py-1 text-1xl">{descZh ? <LocalizedText en={desc} zh={descZh} /> : desc}</p>
        <div class="card-actions justify-end">
          {
            tags &&
              tags.map((tag) => (
                <a href={`${tag_url}/${tag}`} class="relative z-10 badge badge-outline">
                  {tag}
                </a>
              ))
          }
        </div>
      </div>
    </div>
  </CardContent>
  {projectId && <div class="px-4 pb-4 flex flex-wrap items-center justify-end gap-x-5 gap-y-2">
    {playUrl && <a href={playUrl} target="_blank" rel="noopener noreferrer" class="relative z-10 btn btn-sm btn-primary">
      <LocalizedText en="Play" zh="试玩" /> <span aria-hidden="true">↗</span>
    </a>}
    {jamUrl && <a href={jamUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
      <LocalizedText en="Jam entry" zh="参赛页面" /> <span aria-hidden="true">↗</span>
    </a>}
    {portfolioPdf && <a href={portfolioPdf} target="_blank" rel="noopener noreferrer" class={linkClass}>
      <LocalizedText en={`Portfolio PDF · pp. ${portfolioPages}`} zh={`作品集 PDF · 第 ${portfolioPages} 页`} /> <span aria-hidden="true">↗</span>
    </a>}
    {url && <a href={url} target={target} rel="noopener noreferrer" class={linkClass}>
      {linkLabel ? <LocalizedText en={linkLabel} zh={linkLabelZh ?? linkLabel} /> : <><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z" /></svg>
      GitHub</>} <span aria-hidden="true">↗</span>
    </a>}
  </div>}
  {projectId && <ProjectDetails {projectId} {title} {titleZh} {desc} {descZh} {img} {coverPending} />}
</div>
