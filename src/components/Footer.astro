---
import LocalizedText from "./LocalizedText.astro";
const today = new Date();
---

<footer class="footer footer-center block mb-5 pt-10">
  <div class="pb-2">
    &copy; {today.getFullYear()} Guanhao Wang
  </div>
  <div class="inline opacity-75">
    <LocalizedText en="Built with" zh="基于" />
    <a href="https://astrofy-template.netlify.app/" target="_blank" class="font-bold">Astrofy</a>
  </div>
  <!-- A small extra, kept out of the main navigation: the visitor map. -->
  <div class="pt-2">
    <a href="/visitors" class="visitor-link opacity-75">
      <svg class="visitor-globe" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18" />
        <ellipse class="globe-meridian" cx="12" cy="12" rx="4" ry="9" />
      </svg>
      <LocalizedText en="Visitor Map" zh="访客地图" />
    </a>
  </div>
</footer>

<style>
  .visitor-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    transition: opacity 200ms ease;
  }

  .visitor-link:hover,
  .visitor-link:focus-visible {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .visitor-globe {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  /* On hover the meridian sweeps across, so the globe looks like it is turning. */
  .globe-meridian {
    transform-origin: 12px 12px;
  }

  .visitor-link:is(:hover, :focus-visible) .globe-meridian {
    animation: globe-turn 1.6s linear infinite;
  }

  @keyframes globe-turn {
    from { transform: scaleX(-2.25); }
    to { transform: scaleX(2.25); }
  }

  @media (prefers-reduced-motion: reduce) {
    .visitor-link:is(:hover, :focus-visible) .globe-meridian {
      animation: none;
    }
  }
</style>
