---
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import LocalizedText from "./LocalizedText.astro";
import { pages } from "../data/navigation";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<div class="site-header sticky top-0 z-50 flex h-14 w-full justify-center text-base-content" data-site-header transition:name="site-header" transition:animate="none">
  <div class="flex w-full items-center gap-2 pl-4 pr-[3.75rem] sm:px-4">
    <!-- Avatar and name in the top left, the usual way back to the home page. -->
    <a href="/" class="home-link" title="Home" aria-label="Home">
      <!-- On hover the initials rise out of the top of the badge and an arrow comes up after them, heading back to
           the top, as the link does. -->
      <span class="home-avatar font-heading" aria-hidden="true">
        <span class="avatar-initials">GW</span>
        <span class="avatar-arrow">
          <svg viewBox="0 0 24 24"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" /></svg>
        </span>
      </span>
    </a>
    <div class="ml-auto flex shrink-0 items-center gap-2">
      <nav class="header-links hidden sm:flex" aria-label="Pages">
        {pages.map((page) => (
          <a class="header-link" href={page.href} aria-current={page.href === current ? "page" : undefined}>
            <LocalizedText en={page.en} zh={page.zh} />
          </a>
        ))}
      </nav>
      <a href="mailto:gwang284@wisc.edu" class="header-icon btn btn-square btn-ghost btn-sm" aria-label="Email Guanhao Wang" title="Email">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" style="fill: currentColor;"
          ><path d="M20 4H4c-1.103 0-2 .897-2 2v12c0 1.103.897 2 2 2h16c1.103 0 2-.897 2-2V6c0-1.103-.897-2-2-2zm0 2v.511l-8 5.333-8-5.333V6h16zM4 18V8.916l8 5.333 8-5.333V18H4z"></path></svg
        >
      </a>
      <a href="https://github.com/HowellWang04" target="_blank" class="header-icon btn btn-square btn-ghost btn-sm" aria-label="GitHub" title="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" style="fill: currentColor;"
          ><path fill-rule="evenodd" clip-rule="evenodd" d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z"></path></svg
        >
      </a>
      <LanguageToggle />
      <ThemeToggle />
    </div>
  </div>
</div>

<script>
  // The header stays at the top. It is clear at the very top of the page (the home hero runs up under it) and
  // takes the page colour once anything scrolls beneath it.
  const updateHeader = () => {
    document.querySelector("[data-site-header]")?.classList.toggle("is-solid", window.scrollY > 0);
  };

  window.addEventListener("scroll", updateHeader, { passive: true });
  document.addEventListener("astro:page-load", updateHeader);
  updateHeader();
</script>

<style>
  .site-header {
    border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    transition: background-color 240ms ease;
  }

  .site-header.is-solid {
    background-color: var(--portfolio-canvas);
  }

  .home-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }

  /* A monogram badge in the brand colour. */
  .home-avatar {
    --rise: 2.25rem;
    position: relative;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 9999px;
    background: oklch(var(--p));
    color: oklch(var(--pc));
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1;
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 320ms ease;
  }

  /* The font's box leaves room below for descenders, which capitals don't use, so the initials sit high.
     Nudge them down onto the middle of the capitals (and a hair left, where the W's ink overhangs). */
  .avatar-initials {
    translate: -0.03em 0.17em;
    transition: transform 420ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .avatar-arrow {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transform: translateY(var(--rise));
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1) 70ms;
  }

  .avatar-arrow svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .home-link:hover .home-avatar,
  .home-link:focus-visible .home-avatar {
    transform: translateY(-2px);
    box-shadow: 0 6px 14px -6px oklch(var(--p) / 0.7);
  }

  .home-link:hover .avatar-initials,
  .home-link:focus-visible .avatar-initials {
    transform: translateY(calc(var(--rise) * -1));
  }

  .home-link:hover .avatar-arrow,
  .home-link:focus-visible .avatar-arrow {
    transform: translateY(0);
  }

  /* Once it has arrived, the arrow keeps shooting up out of the top and coming back in from the bottom. */
  .home-link:hover .avatar-arrow svg,
  .home-link:focus-visible .avatar-arrow svg {
    animation: avatar-launch 1.2s cubic-bezier(0.55, 0, 0.45, 1) 0.6s infinite;
  }

  @keyframes avatar-launch {
    0%, 30% {
      transform: translateY(0);
    }
    42% {
      transform: translateY(0.12rem);
    }
    62% {
      transform: translateY(calc(var(--rise) * -1));
    }
    62.01% {
      transform: translateY(var(--rise));
    }
    100% {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-avatar,
    .avatar-initials,
    .avatar-arrow {
      transition: none;
    }

    .home-link:hover .avatar-arrow svg,
    .home-link:focus-visible .avatar-arrow svg {
      animation: none;
    }
  }

  .header-links {
    gap: 1.75rem;
    margin-right: 1.25rem;
  }

  /* A small dot slides up under the link on hover and stays under the current page. */
  .header-link {
    position: relative;
    font-size: 0.95rem;
  }

  .header-link::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -0.55rem;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: currentColor;
    opacity: 0;
    transform: translate(-50%, 4px) scale(0);
    transition: opacity 240ms ease, transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header-link:hover::after,
  .header-link[aria-current="page"]::after {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .header-link::after {
      transition: none;
    }
  }

  /* The email and GitHub icons hop on hover, over and over: squash to gather, stretch up into the jump, squash again
     on landing, then a small rebound. Squashing from the bottom keeps the icon's feet on the ground. */
  .header-icon svg {
    transform-origin: 50% 100%;
  }

  .header-icon:is(:hover, :focus-visible) svg {
    animation: icon-hop 1s cubic-bezier(0.28, 0.84, 0.42, 1) infinite;
  }

  @keyframes icon-hop {
    0% {
      transform: scale(1, 1) translateY(0);
    }
    10% {
      transform: scale(1.1, 0.9) translateY(0);
    }
    30% {
      transform: scale(0.9, 1.1) translateY(-0.5em);
    }
    50% {
      transform: scale(1.05, 0.95) translateY(0);
    }
    57% {
      transform: scale(1, 1) translateY(-0.125em);
    }
    64%,
    100% {
      transform: scale(1, 1) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-icon:is(:hover, :focus-visible) svg {
      animation: none;
    }
  }
</style>
