---
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import LocalizedText from "./LocalizedText.astro";
import { pages } from "../data/navigation";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<div class="site-header relative z-10 flex h-20 w-full justify-center text-base-content">
  <div class="flex w-full items-center gap-2 px-4">
    <div class="min-w-0">
      <a class="block truncate text-sm font-semibold sm:text-xl" href="/">Guanhao Wang</a>
    </div>
    <div class="ml-auto flex shrink-0 items-center gap-2">
      <nav class="header-links hidden sm:flex" aria-label="Pages">
        {pages.map((page) => (
          <a class="header-link" href={page.href} aria-current={page.href === current ? "page" : undefined}>
            <LocalizedText en={page.en} zh={page.zh} />
          </a>
        ))}
      </nav>
      <a href="mailto:gwang284@wisc.edu" class="btn btn-square btn-ghost btn-sm" aria-label="Email Guanhao Wang" title="Email">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" style="fill: currentColor;"
          ><path d="M20 4H4c-1.103 0-2 .897-2 2v12c0 1.103.897 2 2 2h16c1.103 0 2-.897 2-2V6c0-1.103-.897-2-2-2zm0 2v.511l-8 5.333-8-5.333V6h16zM4 18V8.916l8 5.333 8-5.333V18H4z"></path></svg
        >
      </a>
      <a href="https://github.com/HowellWang04" target="_blank" class="btn btn-square btn-ghost btn-sm" aria-label="GitHub" title="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" style="fill: currentColor;"
          ><path fill-rule="evenodd" clip-rule="evenodd" d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z"></path></svg
        >
      </a>
      <LanguageToggle />
      <ThemeToggle />
    </div>
  </div>
</div>

<style>
  .header-links {
    gap: 1.75rem;
    margin-right: 1.25rem;
  }

  /* A small dot slides up under the link on hover and stays under the current page. */
  .header-link {
    position: relative;
    font-size: 0.95rem;
  }

  .header-link::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -0.55rem;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: currentColor;
    opacity: 0;
    transform: translate(-50%, 4px) scale(0);
    transition: opacity 240ms ease, transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header-link:hover::after,
  .header-link[aria-current="page"]::after {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .header-link::after {
      transition: none;
    }
  }
</style>
